import { Button, LineEdit, ScrollView, ProgressIndicator, Palette, ComboBox } from "std-widgets.slint";

export struct PackageItem {
    name: string,
    version: string,
    votes: int,
    popularity: string,
    description: string,
    maintainer: string,
    updated: string,
}

// Global Theme: semantic tokens for dark and light modes
export global Theme {
    in-out property <bool> force-dark: false;
    in-out property <int> theme-mode: 0; // 0 = System, 1 = Dark, 2 = Light
    out property <bool> dark: theme-mode == 1 || (theme-mode == 0 && (force-dark || Palette.color-scheme == ColorScheme.dark));

    // Backgrounds
    out property <color> window-bg: dark ? #0b0f19 : #f8fafc;
    out property <color> header-bg: dark ? #111827 : #ffffff;
    out property <color> card-bg: dark ? #131d2e : #ffffff;
    out property <color> card-bg-hover: dark ? #1a273e : #f1f5f9;
    out property <color> card-bg-selected: dark ? #1e2e4f : #e0f2fe;
    out property <color> pill-bg: dark ? #1e293b : #f1f5f9;
    out property <color> pill-active-bg: dark ? #0284c7 : #0284c7;
    out property <color> code-bg: dark ? #070b12 : #f1f5f9;
    out property <color> section-bg: dark ? #0e1626 : #f8fafc;

    // Borders
    out property <color> border-subtle: dark ? #1e293b : #e2e8f0;
    out property <color> border-default: dark ? #25334c : #cbd5e1;
    out property <color> border-hover: dark ? #3b4d71 : #94a3b8;
    out property <color> border-selected: dark ? #38bdf8 : #0284c7;

    // Typography
    out property <color> text-primary: dark ? #f8fafc : #0f172a;
    out property <color> text-secondary: dark ? #94a3b8 : #475569;
    out property <color> text-muted: dark ? #64748b : #64748b;
    out property <color> text-accent: dark ? #38bdf8 : #0284c7;
    out property <color> text-date: dark ? #c084fc : #7e22ce;

    // Accents & Badges
    out property <color> vote-color: #10b981;
    out property <color> pop-color: #f59e0b;
    out property <color> warning: #f43f5e;
    out property <color> warning-bg: dark ? #2d121c : #ffe4e6;
    out property <color> badge-vote-bg: dark ? #06281e : #ecfdf5;
    out property <color> badge-pop-bg: dark ? #2a1b08 : #fffbeb;
}

// Global state pushed from Rust
export global AppState {
    in-out property <[PackageItem]> packages: [];
    in-out property <bool> loading: false;
    in-out property <string> status-text: "Ready";
    in-out property <int> active-tab: 0; // 0 = Last Updated, 1 = Newest Submissions, 2 = Search
    in-out property <string> last-fetched-str: "";
    in-out property <string> search-filter: "";
    in-out property <int> total-items-count: 0;
    in-out property <int> displayed-items-count: 0;

    // Search tab state
    in-out property <string> search-query: "";
    in-out property <int> search-by: 1; // default to name-desc (index 1)
    in-out property <int> search-page: 1;
    in-out property <int> search-total-pages: 1;
    in-out property <int> search-result-count: 0;
    in-out property <bool> search-loading: false;
    in-out property <[string]> suggestions: [];
    in-out property <string> search-error: "";          // non-empty when last search failed
    in-out property <[string]> search-history: [];       // up to 10 recent queries

    // Detail view state
    in-out property <bool> show-detail: false;
    in-out property <string> detail-name: "";
    in-out property <string> detail-version: "";
    in-out property <string> detail-description: "";
    in-out property <string> detail-maintainer: "";
    in-out property <int> detail-votes: 0;
    in-out property <float> detail-popularity: 0.0;
    in-out property <string> detail-url: "";
    in-out property <string> detail-license: "";
    in-out property <[string]> detail-depends: [];
    in-out property <[string]> detail-make-depends: [];
    in-out property <[string]> detail-opt-depends: [];
    in-out property <[string]> detail-check-depends: [];
    in-out property <[string]> detail-provides: [];
    in-out property <[string]> detail-conflicts: [];
    in-out property <[string]> detail-replaces: [];
    in-out property <[string]> detail-groups: [];
    in-out property <[string]> detail-keywords: [];
    in-out property <[string]> detail-co-maintainers: [];
    in-out property <string> detail-first-submitted: "";
    in-out property <string> detail-last-modified: "";
    in-out property <string> detail-out-of-date: "";
    in-out property <string> detail-submitter: "";

    // Settings state
    in-out property <bool> show-settings: false;
    in-out property <int> theme-mode: 0; // 0 = System, 1 = Dark, 2 = Light
    in-out property <string> aur-helper: "yay"; // yay, paru, pikaur, aura, pacman
    in-out property <int> default-search-by: 1; // index 0..7
    in-out property <int> search-page-size: 50; // 25, 50, 100
    in-out property <string> cache-path: "";
    in-out property <string> cache-size-str: "";
    in-out property <string> api-endpoint: "https://aur.archlinux.org/rpc/v5";
    in-out property <string> app-version: "0.1.0";
}

// Global logic callbacks handled by Rust
export global AppLogic {
    callback refresh-requested();
    callback open-pkg-page(string);
    callback open-url(string);
    callback tab-changed(int);

    // Settings callbacks
    callback toggle-settings();
    callback close-settings();
    callback theme-mode-changed(int);
    callback aur-helper-changed(string);
    callback default-search-by-changed(int);
    callback search-page-size-changed(int);
    callback clear-cache-requested();

    // Search callbacks
    callback search-requested(string, int, int);
    callback search-page-changed(int);
    callback search-by-changed(int);
    callback get-suggestions(string);
    callback dismiss-suggestions();
    callback retry-search();
    callback clear-search-history();

    // Filter callback
    callback filter-changed(string);

    // Detail view callbacks
    callback show-package-detail(string);
    callback close-detail();
}

// Navigation Tab Component
component NavTab inherits Rectangle {
    in property <string> title;
    in property <string> icon;
    in property <bool> active: false;
    callback clicked();

    height: 32px;
    border-radius: 6px;
    background: root.active ? Theme.card-bg : (touch.has-hover ? Theme.card-bg-hover : Colors.transparent);
    border-width: root.active ? 1px : 0px;
    border-color: Theme.border-subtle;

    animate background { duration: 150ms; }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 6px;
        alignment: center;

        Text {
            text: root.icon;
            font-size: 13px;
            vertical-alignment: center;
        }

        Text {
            text: root.title;
            font-size: 13px;
            font-weight: root.active ? 600 : 500;
            color: root.active ? Theme.text-accent : (touch.has-hover ? Theme.text-primary : Theme.text-secondary);
            vertical-alignment: center;
        }
    }
}

// Package Card in the main list
component PackageCard inherits Rectangle {
    in property <PackageItem> pkg;
    in property <bool> selected: false;

    vertical-stretch: 0;
    background: root.selected
        ? Theme.card-bg-selected
        : (touch.has-hover ? Theme.card-bg-hover : Theme.card-bg);
    border-radius: 8px;
    border-width: 1px;
    border-color: root.selected
        ? Theme.border-selected
        : (touch.has-hover ? Theme.border-hover : Theme.border-default);

    animate background { duration: 150ms; }
    animate border-color { duration: 150ms; }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { AppLogic.show-package-detail(root.pkg.name); }
    }

    VerticalLayout {
        padding: 12px;
        spacing: 6px;
        alignment: start;

        // Row 1: Name, Version badge, Maintainer, Updated Date
        HorizontalLayout {
            height: 24px;
            vertical-stretch: 0;
            spacing: 8px;

            Text {
                text: root.pkg.name;
                font-size: 15px;
                font-weight: 700;
                color: Theme.text-accent;
                vertical-alignment: center;
            }

            Rectangle {
                height: 22px;
                vertical-stretch: 0;
                background: Theme.pill-bg;
                border-radius: 4px;
                border-width: 1px;
                border-color: Theme.border-subtle;
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    alignment: center;
                    Text {
                        text: "v" + root.pkg.version;
                        font-size: 11px;
                        font-weight: 500;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                    }
                }
            }

            Rectangle { horizontal-stretch: 1; }

            if root.pkg.maintainer != "": HorizontalLayout {
                spacing: 4px;
                Text {
                    text: "👤";
                    font-size: 11px;
                    vertical-alignment: center;
                }
                Text {
                    text: root.pkg.maintainer;
                    font-size: 11px;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                }
            }

            HorizontalLayout {
                spacing: 4px;
                Text {
                    text: "🕒";
                    font-size: 11px;
                    vertical-alignment: center;
                }
                Text {
                    text: root.pkg.updated;
                    font-size: 11px;
                    font-weight: 500;
                    color: Theme.text-date;
                    vertical-alignment: center;
                }
            }
        }

        // Row 2: Description
        Text {
            text: root.pkg.description != "" ? root.pkg.description : "(no description provided)";
            font-size: 12px;
            color: Theme.text-secondary;
            wrap: word-wrap;
            max-height: 36px;
            vertical-stretch: 0;
        }

        // Row 3: Stats (Votes, Popularity) & Action prompt
        HorizontalLayout {
            height: 24px;
            vertical-stretch: 0;
            spacing: 10px;

            if root.pkg.votes > 0: Rectangle {
                height: 22px;
                vertical-stretch: 0;
                background: Theme.badge-vote-bg;
                border-radius: 4px;
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 4px;
                    alignment: center;
                    Text {
                        text: "▲";
                        font-size: 10px;
                        color: Theme.vote-color;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.pkg.votes + " votes";
                        font-size: 11px;
                        font-weight: 600;
                        color: Theme.vote-color;
                        vertical-alignment: center;
                    }
                }
            }

            if root.pkg.popularity != "": Rectangle {
                height: 22px;
                vertical-stretch: 0;
                background: Theme.badge-pop-bg;
                border-radius: 4px;
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 4px;
                    alignment: center;
                    Text {
                        text: "★";
                        font-size: 10px;
                        color: Theme.pop-color;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.pkg.popularity + " pop";
                        font-size: 11px;
                        font-weight: 600;
                        color: Theme.pop-color;
                        vertical-alignment: center;
                    }
                }
            }

            Rectangle { horizontal-stretch: 1; }

            Text {
                text: touch.has-hover ? "Inspect package →" : "";
                font-size: 11px;
                font-weight: 600;
                color: Theme.text-accent;
                vertical-alignment: center;
            }
        }
    }
}

// Search bar component for the Search tab
component SearchBar inherits Rectangle {
    in-out property <string> query: "";
    in-out property <int> by: 1;
    in-out property <bool> loading: false;
    in-out property <int> page: 1;
    in-out property <int> total-pages: 1;
    in-out property <int> result-count: 0;
    in-out property <[string]> suggestions: [];
    in-out property <string> search-error: "";
    in-out property <[string]> search-history: [];
    // Which suggestion row is highlighted (-1 = none)
    in-out property <int> suggestion-index: -1;

    callback search-requested(string, int, int);
    callback page-changed(int);
    callback by-changed(int);
    callback get-suggestions(string);
    callback dismiss-suggestions();
    callback retry-search();
    callback clear-history();

    // Whether the autocomplete/history panel is visible
    private property <bool> show-dropdown:
        (root.suggestions.length > 0 || (root.query == "" && root.search-history.length > 0))
        && search-input.has-focus;

    vertical-stretch: 0;
    background: Theme.card-bg;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.border-default;

    VerticalLayout {
        padding: 10px;
        spacing: 8px;
        alignment: start;

        // ── Row 1: Search input, SearchBy dropdown, Search button ───────────
        HorizontalLayout {
            height: 34px;
            vertical-stretch: 0;
            spacing: 8px;

            search-input := LineEdit {
                text <=> root.query;
                placeholder-text: "Search AUR packages (e.g. google-chrome, spotify, yay)…";
                horizontal-stretch: 1;
                edited => {
                    root.suggestion-index = -1;
                    root.get-suggestions(root.query);
                }
                accepted => {
                    if (root.query != "" && !root.loading) {
                        root.suggestion-index = -1;
                        root.search-requested(root.query, root.by, 1);
                    }
                }
                key-pressed(ev) => {
                    if (ev.text == Key.Escape) {
                        root.query = "";
                        root.suggestion-index = -1;
                        root.dismiss-suggestions();
                        return accept;
                    }
                    if (ev.text == Key.DownArrow) {
                        if (root.suggestions.length > 0) {
                            root.suggestion-index = Math.min(
                                root.suggestion-index + 1,
                                root.suggestions.length - 1
                            );
                        }
                        return accept;
                    }
                    if (ev.text == Key.UpArrow) {
                        if (root.suggestion-index > 0) {
                            root.suggestion-index = root.suggestion-index - 1;
                        } else {
                            root.suggestion-index = -1;
                        }
                        return accept;
                    }
                    if (ev.text == Key.Tab) {
                        if (root.suggestion-index >= 0 && root.suggestion-index < root.suggestions.length) {
                            root.query = root.suggestions[root.suggestion-index];
                            root.suggestion-index = -1;
                            root.dismiss-suggestions();
                        }
                        return accept;
                    }
                    return reject;
                }
            }

            ComboBox {
                model: ["Name & Desc", "Name only", "Depends", "Check Depends", "Opt Depends", "Make Depends", "Maintainer", "Submitter"];
                current-index <=> root.by;
                width: 140px;
                selected(val) => {
                    root.by-changed(root.by);
                }
            }

            Button {
                text: root.loading ? "Searching…" : "Search";
                enabled: !root.loading && root.query != "";
                primary: true;
                clicked => {
                    root.suggestion-index = -1;
                    root.search-requested(root.query, root.by, 1);
                }
            }
        }

        // ── Autocomplete & History Dropdown (floating below the input) ──────
        if root.show-dropdown: Rectangle {
            vertical-stretch: 0;
            background: Theme.card-bg;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.border-default;
            clip: true;

            VerticalLayout {
                spacing: 0px;
                alignment: start;

                // History header row (shown when query is empty and history exists)
                if root.query == "" && root.search-history.length > 0: HorizontalLayout {
                    height: 28px;
                    vertical-stretch: 0;
                    padding-left: 10px;
                    padding-right: 6px;
                    alignment: space-between;

                    Text {
                        text: "Recent searches";
                        font-size: 10px;
                        font-weight: 700;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        height: 20px;
                        border-radius: 4px;
                        background: clrhist-touch.has-hover ? Theme.card-bg-hover : Colors.transparent;

                        clrhist-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.clear-history(); }
                        }
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            alignment: center;
                            Text {
                                text: "Clear";
                                font-size: 10px;
                                font-weight: 600;
                                color: Theme.text-accent;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Suggestion rows (from API) or history rows (when query empty)
                for item[idx] in (root.query != "" ? root.suggestions : root.search-history): Rectangle {
                    height: 32px;
                    vertical-stretch: 0;
                    background: idx == root.suggestion-index
                        ? Theme.card-bg-selected
                        : (sug-touch.has-hover ? Theme.card-bg-hover : Colors.transparent);
                    animate background { duration: 100ms; }

                    sug-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.query = item;
                            root.suggestion-index = -1;
                            root.dismiss-suggestions();
                            root.search-requested(item, root.by, 1);
                        }
                    }

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;
                        alignment: start;

                        Text {
                            text: root.query != "" ? "🔍" : "🕐";
                            font-size: 11px;
                            vertical-alignment: center;
                            color: Theme.text-muted;
                        }

                        Text {
                            text: item;
                            font-size: 13px;
                            color: idx == root.suggestion-index ? Theme.text-accent : Theme.text-primary;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
        }

        // ── Loading skeleton cards (shown while search-loading is true) ──────
        if root.loading: VerticalLayout {
            spacing: 8px;
            vertical-stretch: 0;

            for i in [0, 1, 2]: Rectangle {
                height: 90px;
                vertical-stretch: 0;
                background: Theme.card-bg;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.border-subtle;

                // Overlay shimmer — pulses between card-bg and card-bg-hover
                Rectangle {
                    x: 0;
                    y: 0;
                    width: 100%;
                    height: 100%;
                    border-radius: 8px;
                    background: Theme.card-bg-hover;
                    opacity: 0.5;
                }

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    alignment: start;

                    // Title bar skeleton
                    Rectangle {
                        height: 14px;
                        width: 220px;
                        border-radius: 4px;
                        background: Theme.border-default;
                    }
                    // Description skeleton line 1
                    Rectangle {
                        height: 10px;
                        width: 380px;
                        border-radius: 3px;
                        background: Theme.border-subtle;
                    }
                    // Description skeleton line 2
                    Rectangle {
                        height: 10px;
                        width: 280px;
                        border-radius: 3px;
                        background: Theme.border-subtle;
                    }
                }
            }
        }

        // ── Error state with retry button ────────────────────────────────────
        if root.search-error != "" && !root.loading: Rectangle {
            vertical-stretch: 0;
            background: Theme.warning-bg;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.warning;

            HorizontalLayout {
                padding: 12px;
                spacing: 12px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    horizontal-stretch: 1;

                    Text {
                        text: "⚠️";
                        font-size: 16px;
                        vertical-alignment: center;
                    }

                    VerticalLayout {
                        spacing: 2px;
                        alignment: center;
                        Text {
                            text: "Search failed";
                            font-size: 12px;
                            font-weight: 700;
                            color: Theme.warning;
                        }
                        Text {
                            text: root.search-error;
                            font-size: 11px;
                            color: Theme.text-secondary;
                            wrap: word-wrap;
                        }
                    }
                }

                Rectangle {
                    height: 32px;
                    border-radius: 6px;
                    background: retry-touch.has-hover ? Theme.warning : Theme.section-bg;
                    border-width: 1px;
                    border-color: Theme.warning;
                    animate background { duration: 150ms; }

                    retry-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.retry-search(); }
                    }

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        alignment: center;
                        spacing: 6px;
                        Text {
                            text: "↺";
                            font-size: 13px;
                            color: retry-touch.has-hover ? #ffffff : Theme.warning;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "Retry";
                            font-size: 12px;
                            font-weight: 600;
                            color: retry-touch.has-hover ? #ffffff : Theme.warning;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // ── Results info & Pagination (visible if results exist) ─────────────
        if root.result-count > 0 && !root.loading: HorizontalLayout {
            height: 30px;
            vertical-stretch: 0;
            spacing: 12px;
            alignment: space-between;

            Text {
                text: "Found " + root.result-count + " package" + (root.result-count == 1 ? "" : "s");
                font-size: 12px;
                font-weight: 500;
                color: Theme.text-secondary;
                vertical-alignment: center;
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: end;

                Button {
                    text: "◀ Prev";
                    enabled: root.page > 1 && !root.loading;
                    clicked => { root.page-changed(root.page - 1); }
                }

                Text {
                    text: "Page " + root.page + " of " + root.total-pages;
                    font-size: 12px;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                }

                Button {
                    text: "Next ▶";
                    enabled: root.page < root.total-pages && !root.loading;
                    clicked => { root.page-changed(root.page + 1); }
                }
            }
        }

        // ── History chips (shown below input when no results yet) ────────────
        if root.search-history.length > 0 && root.result-count == 0 && root.search-error == "" && !root.loading && !root.show-dropdown: VerticalLayout {
            spacing: 6px;
            vertical-stretch: 0;

            HorizontalLayout {
                height: 18px;
                vertical-stretch: 0;
                spacing: 8px;
                alignment: start;

                Text {
                    text: "Recent:";
                    font-size: 11px;
                    font-weight: 600;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }
            }

            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                vertical-stretch: 0;

                for hist-item in root.search-history: Rectangle {
                    height: 26px;
                    border-radius: 13px;
                    background: chip-touch.has-hover ? Theme.pill-active-bg : Theme.pill-bg;
                    border-width: 1px;
                    border-color: chip-touch.has-hover ? Theme.border-selected : Theme.border-subtle;
                    animate background { duration: 150ms; }

                    chip-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.query = hist-item;
                            root.search-requested(hist-item, root.by, 1);
                        }
                    }

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        alignment: center;
                        spacing: 4px;
                        Text {
                            text: "🕐";
                            font-size: 10px;
                            color: chip-touch.has-hover ? #ffffff : Theme.text-muted;
                            vertical-alignment: center;
                        }
                        Text {
                            text: hist-item;
                            font-size: 11px;
                            font-weight: 500;
                            color: chip-touch.has-hover ? #ffffff : Theme.text-secondary;
                            vertical-alignment: center;
                        }
                    }
                }

                // Clear history chip
                Rectangle {
                    height: 26px;
                    border-radius: 13px;
                    background: clr-touch.has-hover ? Theme.warning-bg : Colors.transparent;
                    border-width: 1px;
                    border-color: clr-touch.has-hover ? Theme.warning : Theme.border-subtle;
                    animate background { duration: 150ms; }

                    clr-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.clear-history(); }
                    }

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        alignment: center;
                        Text {
                            text: "✕ Clear";
                            font-size: 10px;
                            font-weight: 600;
                            color: clr-touch.has-hover ? Theme.warning : Theme.text-muted;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}

// Package Detail Pane (Inspector)
component PackageDetail inherits Rectangle {
    in property <string> name: "";
    in property <string> version: "";
    in property <string> description: "";
    in property <string> maintainer: "";
    in property <int> votes: 0;
    in property <float> popularity: 0.0;
    in property <string> url: "";
    in property <string> license: "";
    in property <[string]> depends: [];
    in property <[string]> make-depends: [];
    in property <[string]> opt-depends: [];
    in property <[string]> check-depends: [];
    in property <[string]> provides: [];
    in property <[string]> conflicts: [];
    in property <[string]> replaces: [];
    in property <[string]> groups: [];
    in property <[string]> keywords: [];
    in property <[string]> co-maintainers: [];
    in property <string> first-submitted: "";
    in property <string> last-modified: "";
    in property <string> out-of-date: "";
    in property <string> submitter: "";

    background: Theme.card-bg;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.border-default;
    clip: true;

    // Outer layout containing header, divider, and scrollable content
    VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: 0px;

        // Detail Header
        Rectangle {
            height: 48px;
            vertical-stretch: 0;
            background: Theme.header-bg;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 8px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: root.name;
                        font-size: 16px;
                        font-weight: 700;
                        color: Theme.text-accent;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    Rectangle {
                        height: 22px;
                        background: Theme.pill-bg;
                        border-radius: 4px;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            alignment: center;
                            Text {
                                text: "v" + root.version;
                                font-size: 11px;
                                color: Theme.text-secondary;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    // Open on AUR website button
                    Rectangle {
                        height: 28px;
                        border-radius: 6px;
                        background: web-touch.has-hover ? Theme.card-bg-hover : Theme.pill-bg;
                        border-width: 1px;
                        border-color: Theme.border-subtle;
                        animate background { duration: 150ms; }

                        web-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.open-pkg-page(root.name); }
                        }

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 4px;
                            alignment: center;
                            Text {
                                text: "AUR ↗";
                                font-size: 11px;
                                font-weight: 600;
                                color: Theme.text-accent;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Close button
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 6px;
                        background: close-touch.has-hover ? Theme.card-bg-hover : Theme.pill-bg;
                        border-width: 1px;
                        border-color: Theme.border-subtle;
                        animate background { duration: 150ms; }

                        close-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.close-detail(); }
                        }

                        Text {
                            text: "✕";
                            font-size: 12px;
                            font-weight: 600;
                            color: Theme.text-secondary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Thin separator line
        Rectangle {
            height: 1px;
            vertical-stretch: 0;
            background: Theme.border-subtle;
        }

        // Scrollable Body
        ScrollView {
            vertical-stretch: 1;
            horizontal-scrollbar-policy: always-off;

            VerticalLayout {
                padding: 14px;
                spacing: 12px;
                alignment: start;

                // Quick Install Snippet
                Rectangle {
                    background: Theme.code-bg;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 4px;

                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            Text {
                                text: ">_";
                                font-size: 12px;
                                font-weight: 700;
                                color: Theme.text-accent;
                            }
                            Text {
                                text: AppState.aur-helper + " -S " + root.name;
                                font-size: 12px;
                                font-weight: 600;
                                color: Theme.text-primary;
                            }
                        }

                        Text {
                            text: "Install with " + AppState.aur-helper + " or your preferred AUR helper";
                            font-size: 10px;
                            color: Theme.text-muted;
                        }
                    }
                }

                // Upstream URL
                Rectangle {
                    background: Theme.section-bg;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 8px;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            horizontal-stretch: 1;

                            Text {
                                text: "🌐";
                                font-size: 13px;
                                vertical-alignment: center;
                            }

                            Text {
                                text: "Upstream URL:";
                                font-size: 11px;
                                font-weight: 700;
                                color: Theme.text-muted;
                                vertical-alignment: center;
                            }

                            Text {
                                text: root.url != "" ? root.url : "(none specified)";
                                font-size: 12px;
                                font-weight: root.url != "" ? 600 : 400;
                                color: root.url != "" ? Theme.text-accent : Theme.text-muted;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }

                        if root.url != "": Rectangle {
                            height: 24px;
                            border-radius: 4px;
                            background: upstream-touch.has-hover ? Theme.card-bg-hover : Theme.pill-bg;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            animate background { duration: 150ms; }

                            upstream-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { AppLogic.open-url(root.url); }
                            }

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                alignment: center;
                                Text {
                                    text: "Open ↗";
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: Theme.text-accent;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // Out of date warning banner if applicable
                if root.out-of-date != "": Rectangle {
                    background: Theme.warning-bg;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: Theme.warning;

                    HorizontalLayout {
                        padding: 10px;
                        spacing: 8px;
                        alignment: start;

                        Text {
                            text: "⚠️";
                            font-size: 14px;
                            vertical-alignment: center;
                        }

                        VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: "Flagged Out-of-Date";
                                font-size: 12px;
                                font-weight: 700;
                                color: Theme.warning;
                            }
                            Text {
                                text: "Date: " + root.out-of-date;
                                font-size: 11px;
                                color: Theme.text-secondary;
                            }
                        }
                    }
                }

                // Description
                VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: "DESCRIPTION";
                        font-size: 10px;
                        font-weight: 700;
                        color: Theme.text-muted;
                    }
                    Text {
                        text: root.description != "" ? root.description : "(No description provided)";
                        font-size: 13px;
                        color: Theme.text-primary;
                        wrap: word-wrap;
                    }
                }

                // Key Stats & Metadata Grid
                Rectangle {
                    background: Theme.section-bg;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 8px;

                        // Row 1: Votes & Popularity
                        HorizontalLayout {
                            spacing: 12px;

                            HorizontalLayout {
                                spacing: 4px;
                                horizontal-stretch: 1;
                                Text { text: "▲"; font-size: 11px; color: Theme.vote-color; vertical-alignment: center; }
                                Text { text: root.votes + " votes"; font-size: 12px; font-weight: 600; color: Theme.vote-color; vertical-alignment: center; }
                            }

                            HorizontalLayout {
                                spacing: 4px;
                                horizontal-stretch: 1;
                                Text { text: "★"; font-size: 11px; color: Theme.pop-color; vertical-alignment: center; }
                                Text { text: root.popularity + " pop"; font-size: 12px; font-weight: 600; color: Theme.pop-color; vertical-alignment: center; }
                            }
                        }

                        // Row 2: Maintainer & Submitter
                        HorizontalLayout {
                            spacing: 12px;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: "MAINTAINER"; font-size: 9px; font-weight: 600; color: Theme.text-muted; }
                                Text { text: root.maintainer != "" ? root.maintainer : "(orphan / none)"; font-size: 12px; color: Theme.text-primary; }
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: "SUBMITTER"; font-size: 9px; font-weight: 600; color: Theme.text-muted; }
                                Text { text: root.submitter != "" ? root.submitter : "unknown"; font-size: 12px; color: Theme.text-primary; }
                            }
                        }

                        // Row 3: Timestamps
                        HorizontalLayout {
                            spacing: 12px;

                            if root.last-modified != "": VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: "LAST MODIFIED"; font-size: 9px; font-weight: 600; color: Theme.text-muted; }
                                Text { text: root.last-modified; font-size: 11px; color: Theme.text-secondary; }
                            }

                            if root.first-submitted != "": VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: "FIRST SUBMITTED"; font-size: 9px; font-weight: 600; color: Theme.text-muted; }
                                Text { text: root.first-submitted; font-size: 11px; color: Theme.text-secondary; }
                            }
                        }
                    }
                }

                // License
                if root.license != "": VerticalLayout {
                    spacing: 4px;
                    Text { text: "LICENSE"; font-size: 10px; font-weight: 700; color: Theme.text-muted; }
                    Text { text: root.license; font-size: 12px; color: Theme.text-primary; wrap: word-wrap; }
                }

                // Dependencies
                if root.depends.length > 0: VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: "DEPENDENCIES (" + root.depends.length + ")";
                        font-size: 10px;
                        font-weight: 700;
                        color: Theme.text-muted;
                    }

                    VerticalLayout {
                        spacing: 4px;
                        for dep in root.depends: Rectangle {
                            height: 26px;
                            background: Theme.pill-bg;
                            border-radius: 4px;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                alignment: start;
                                Text {
                                    text: "• " + dep;
                                    font-size: 12px;
                                    color: Theme.text-secondary;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // Make Dependencies
                if root.make-depends.length > 0: VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: "MAKE DEPENDENCIES (" + root.make-depends.length + ")";
                        font-size: 10px;
                        font-weight: 700;
                        color: Theme.text-muted;
                    }

                    VerticalLayout {
                        spacing: 4px;
                        for dep in root.make-depends: Rectangle {
                            height: 26px;
                            background: Theme.pill-bg;
                            border-radius: 4px;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                alignment: start;
                                Text {
                                    text: "• " + dep;
                                    font-size: 12px;
                                    color: Theme.text-secondary;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // Optional Dependencies
                if root.opt-depends.length > 0: VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: "OPTIONAL DEPENDENCIES (" + root.opt-depends.length + ")";
                        font-size: 10px;
                        font-weight: 700;
                        color: Theme.text-muted;
                    }

                    VerticalLayout {
                        spacing: 4px;
                        for dep in root.opt-depends: Rectangle {
                            height: 26px;
                            background: Theme.pill-bg;
                            border-radius: 4px;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                alignment: start;
                                Text {
                                    text: "• " + dep;
                                    font-size: 12px;
                                    color: Theme.text-secondary;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // Provides
                if root.provides.length > 0: VerticalLayout {
                    spacing: 6px;
                    Text { text: "PROVIDES"; font-size: 10px; font-weight: 700; color: Theme.text-muted; }
                    VerticalLayout {
                        spacing: 4px;
                        for item in root.provides: Rectangle {
                            height: 26px;
                            background: Theme.pill-bg;
                            border-radius: 4px;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                alignment: start;
                                Text { text: "• " + item; font-size: 12px; color: Theme.text-secondary; vertical-alignment: center; }
                            }
                        }
                    }
                }

                // Conflicts
                if root.conflicts.length > 0: VerticalLayout {
                    spacing: 6px;
                    Text { text: "CONFLICTS"; font-size: 10px; font-weight: 700; color: Theme.text-muted; }
                    VerticalLayout {
                        spacing: 4px;
                        for item in root.conflicts: Rectangle {
                            height: 26px;
                            background: Theme.pill-bg;
                            border-radius: 4px;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                alignment: start;
                                Text { text: "• " + item; font-size: 12px; color: Theme.text-secondary; vertical-alignment: center; }
                            }
                        }
                    }
                }
            }
        }
    }
}

component SettingsSectionCard inherits Rectangle {
    in property <string> title: "";
    in property <string> subtitle: "";

    background: Theme.card-bg;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.border-default;

    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 10px;

        VerticalLayout {
            spacing: 2px;
            Text {
                text: root.title;
                font-size: 14px;
                font-weight: 700;
                color: Theme.text-primary;
            }
            if root.subtitle != "": Text {
                text: root.subtitle;
                font-size: 11px;
                color: Theme.text-secondary;
            }
        }

        @children
    }
}

component SettingsView inherits Rectangle {
    background: transparent;

    VerticalLayout {
        spacing: 14px;

        // Settings Top Bar
        HorizontalLayout {
            height: 38px;
            vertical-stretch: 0;
            alignment: space-between;

            VerticalLayout {
                spacing: 1px;
                alignment: center;
                Text {
                    text: "Settings";
                    font-size: 18px;
                    font-weight: 700;
                    color: Theme.text-primary;
                }
                Text {
                    text: "Configure appearance, AUR helper, search defaults, and local cache";
                    font-size: 11px;
                    color: Theme.text-secondary;
                }
            }

            Rectangle {
                height: 32px;
                background: back-touch.has-hover ? Theme.card-bg-hover : Theme.card-bg;
                border-radius: 6px;
                border-width: 1px;
                border-color: Theme.border-default;
                animate background { duration: 150ms; }

                back-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { AppLogic.close-settings(); }
                }

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    alignment: center;
                    spacing: 6px;
                    Text {
                        text: "← Back to Packages";
                        font-size: 12px;
                        font-weight: 600;
                        color: Theme.text-accent;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Scrollable Settings Sections
        ScrollView {
            vertical-stretch: 1;
            horizontal-scrollbar-policy: always-off;

            VerticalLayout {
                padding-right: 12px;
                padding-bottom: 24px;
                spacing: 16px;
                alignment: start;

                // 1. Appearance & Theme
                SettingsSectionCard {
                    title: "🎨 Appearance & Theme";
                    subtitle: "Select your preferred color scheme across the entire application";

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;

                        // System Default
                        Rectangle {
                            height: 34px;
                            border-radius: 6px;
                            background: AppState.theme-mode == 0 ? Theme.pill-active-bg : (sys-touch.has-hover ? Theme.card-bg-hover : Theme.pill-bg);
                            border-width: 1px;
                            border-color: AppState.theme-mode == 0 ? Theme.border-selected : Theme.border-subtle;
                            animate background { duration: 150ms; }

                            sys-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    AppState.theme-mode = 0;
                                    Theme.theme-mode = 0;
                                    AppLogic.theme-mode-changed(0);
                                }
                            }

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: center;
                                spacing: 6px;
                                Text { text: "💻"; font-size: 12px; vertical-alignment: center; }
                                Text {
                                    text: "System Default";
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: AppState.theme-mode == 0 ? #ffffff : Theme.text-primary;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Dark Theme
                        Rectangle {
                            height: 34px;
                            border-radius: 6px;
                            background: AppState.theme-mode == 1 ? Theme.pill-active-bg : (dark-touch.has-hover ? Theme.card-bg-hover : Theme.pill-bg);
                            border-width: 1px;
                            border-color: AppState.theme-mode == 1 ? Theme.border-selected : Theme.border-subtle;
                            animate background { duration: 150ms; }

                            dark-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    AppState.theme-mode = 1;
                                    Theme.theme-mode = 1;
                                    AppLogic.theme-mode-changed(1);
                                }
                            }

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: center;
                                spacing: 6px;
                                Text { text: "🌙"; font-size: 12px; vertical-alignment: center; }
                                Text {
                                    text: "Dark Theme";
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: AppState.theme-mode == 1 ? #ffffff : Theme.text-primary;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Light Theme
                        Rectangle {
                            height: 34px;
                            border-radius: 6px;
                            background: AppState.theme-mode == 2 ? Theme.pill-active-bg : (light-touch.has-hover ? Theme.card-bg-hover : Theme.pill-bg);
                            border-width: 1px;
                            border-color: AppState.theme-mode == 2 ? Theme.border-selected : Theme.border-subtle;
                            animate background { duration: 150ms; }

                            light-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    AppState.theme-mode = 2;
                                    Theme.theme-mode = 2;
                                    AppLogic.theme-mode-changed(2);
                                }
                            }

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: center;
                                spacing: 6px;
                                Text { text: "☀️"; font-size: 12px; vertical-alignment: center; }
                                Text {
                                    text: "Light Theme";
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: AppState.theme-mode == 2 ? #ffffff : Theme.text-primary;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // 2. AUR Helper & Terminal Command
                SettingsSectionCard {
                    title: "📦 AUR Helper & Terminal Command";
                    subtitle: "Select which helper to use when generating quick installation commands in the package inspector";

                    VerticalLayout {
                        spacing: 10px;

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;

                            // yay
                            Rectangle {
                                height: 32px;
                                border-radius: 6px;
                                background: AppState.aur-helper == "yay" ? Theme.pill-active-bg : (yay-touch.has-hover ? Theme.card-bg-hover : Theme.pill-bg);
                                border-width: 1px;
                                border-color: AppState.aur-helper == "yay" ? Theme.border-selected : Theme.border-subtle;
                                animate background { duration: 150ms; }

                                yay-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        AppState.aur-helper = "yay";
                                        AppLogic.aur-helper-changed("yay");
                                    }
                                }

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    alignment: center;
                                    Text {
                                        text: "yay";
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: AppState.aur-helper == "yay" ? #ffffff : Theme.text-primary;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // paru
                            Rectangle {
                                height: 32px;
                                border-radius: 6px;
                                background: AppState.aur-helper == "paru" ? Theme.pill-active-bg : (paru-touch.has-hover ? Theme.card-bg-hover : Theme.pill-bg);
                                border-width: 1px;
                                border-color: AppState.aur-helper == "paru" ? Theme.border-selected : Theme.border-subtle;
                                animate background { duration: 150ms; }

                                paru-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        AppState.aur-helper = "paru";
                                        AppLogic.aur-helper-changed("paru");
                                    }
                                }

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    alignment: center;
                                    Text {
                                        text: "paru";
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: AppState.aur-helper == "paru" ? #ffffff : Theme.text-primary;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // pikaur
                            Rectangle {
                                height: 32px;
                                border-radius: 6px;
                                background: AppState.aur-helper == "pikaur" ? Theme.pill-active-bg : (pikaur-touch.has-hover ? Theme.card-bg-hover : Theme.pill-bg);
                                border-width: 1px;
                                border-color: AppState.aur-helper == "pikaur" ? Theme.border-selected : Theme.border-subtle;
                                animate background { duration: 150ms; }

                                pikaur-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        AppState.aur-helper = "pikaur";
                                        AppLogic.aur-helper-changed("pikaur");
                                    }
                                }

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    alignment: center;
                                    Text {
                                        text: "pikaur";
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: AppState.aur-helper == "pikaur" ? #ffffff : Theme.text-primary;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // aura
                            Rectangle {
                                height: 32px;
                                border-radius: 6px;
                                background: AppState.aur-helper == "aura" ? Theme.pill-active-bg : (aura-touch.has-hover ? Theme.card-bg-hover : Theme.pill-bg);
                                border-width: 1px;
                                border-color: AppState.aur-helper == "aura" ? Theme.border-selected : Theme.border-subtle;
                                animate background { duration: 150ms; }

                                aura-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        AppState.aur-helper = "aura";
                                        AppLogic.aur-helper-changed("aura");
                                    }
                                }

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    alignment: center;
                                    Text {
                                        text: "aura";
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: AppState.aur-helper == "aura" ? #ffffff : Theme.text-primary;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // pacman
                            Rectangle {
                                height: 32px;
                                border-radius: 6px;
                                background: AppState.aur-helper == "pacman" ? Theme.pill-active-bg : (pacman-touch.has-hover ? Theme.card-bg-hover : Theme.pill-bg);
                                border-width: 1px;
                                border-color: AppState.aur-helper == "pacman" ? Theme.border-selected : Theme.border-subtle;
                                animate background { duration: 150ms; }

                                pacman-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        AppState.aur-helper = "pacman";
                                        AppLogic.aur-helper-changed("pacman");
                                    }
                                }

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    alignment: center;
                                    Text {
                                        text: "pacman";
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: AppState.aur-helper == "pacman" ? #ffffff : Theme.text-primary;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // Preview Box
                        Rectangle {
                            background: Theme.code-bg;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: Theme.border-subtle;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                padding-top: 8px;
                                padding-bottom: 8px;
                                spacing: 8px;
                                alignment: start;

                                Text {
                                    text: ">_";
                                    font-size: 12px;
                                    font-weight: 700;
                                    color: Theme.text-accent;
                                }

                                Text {
                                    text: AppState.aur-helper + " -S <package-name>";
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: Theme.text-primary;
                                }
                            }
                        }
                    }
                }

                // 3. Search & Browsing Defaults
                SettingsSectionCard {
                    title: "🔍 Search & Browsing Defaults";
                    subtitle: "Customize default search filter category and pagination page size";

                    VerticalLayout {
                        spacing: 12px;

                        // Default Search By
                        HorizontalLayout {
                            spacing: 16px;
                            alignment: space-between;

                            VerticalLayout {
                                spacing: 1px;
                                alignment: center;
                                Text {
                                    text: "Default Search Category";
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: Theme.text-primary;
                                }
                                Text {
                                    text: "Field targeted by default when opening the Search tab";
                                    font-size: 11px;
                                    color: Theme.text-secondary;
                                }
                            }

                            ComboBox {
                                width: 220px;
                                model: [
                                    "Name only",
                                    "Name & description",
                                    "Depends",
                                    "Check depends",
                                    "Opt depends",
                                    "Make depends",
                                    "Maintainer",
                                    "Submitter"
                                ];
                                current-index <=> AppState.default-search-by;
                                selected(val) => {
                                    AppLogic.default-search-by-changed(self.current-index);
                                }
                            }
                        }

                        Rectangle {
                            height: 1px;
                            background: Theme.border-subtle;
                        }

                        // Results Per Page
                        HorizontalLayout {
                            spacing: 16px;
                            alignment: space-between;

                            VerticalLayout {
                                spacing: 1px;
                                alignment: center;
                                Text {
                                    text: "Search Results Per Page";
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: Theme.text-primary;
                                }
                                Text {
                                    text: "Number of packages displayed per search results page";
                                    font-size: 11px;
                                    color: Theme.text-secondary;
                                }
                            }

                            HorizontalLayout {
                                spacing: 6px;
                                alignment: end;

                                // 25
                                Rectangle {
                                    height: 30px;
                                    width: 46px;
                                    border-radius: 6px;
                                    background: AppState.search-page-size == 25 ? Theme.pill-active-bg : (size25-touch.has-hover ? Theme.card-bg-hover : Theme.pill-bg);
                                    border-width: 1px;
                                    border-color: AppState.search-page-size == 25 ? Theme.border-selected : Theme.border-subtle;
                                    animate background { duration: 150ms; }

                                    size25-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            AppState.search-page-size = 25;
                                            AppLogic.search-page-size-changed(25);
                                        }
                                    }

                                    HorizontalLayout {
                                        alignment: center;
                                        Text {
                                            text: "25";
                                            font-size: 12px;
                                            font-weight: 600;
                                            color: AppState.search-page-size == 25 ? #ffffff : Theme.text-primary;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // 50
                                Rectangle {
                                    height: 30px;
                                    width: 46px;
                                    border-radius: 6px;
                                    background: AppState.search-page-size == 50 ? Theme.pill-active-bg : (size50-touch.has-hover ? Theme.card-bg-hover : Theme.pill-bg);
                                    border-width: 1px;
                                    border-color: AppState.search-page-size == 50 ? Theme.border-selected : Theme.border-subtle;
                                    animate background { duration: 150ms; }

                                    size50-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            AppState.search-page-size = 50;
                                            AppLogic.search-page-size-changed(50);
                                        }
                                    }

                                    HorizontalLayout {
                                        alignment: center;
                                        Text {
                                            text: "50";
                                            font-size: 12px;
                                            font-weight: 600;
                                            color: AppState.search-page-size == 50 ? #ffffff : Theme.text-primary;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // 100
                                Rectangle {
                                    height: 30px;
                                    width: 46px;
                                    border-radius: 6px;
                                    background: AppState.search-page-size == 100 ? Theme.pill-active-bg : (size100-touch.has-hover ? Theme.card-bg-hover : Theme.pill-bg);
                                    border-width: 1px;
                                    border-color: AppState.search-page-size == 100 ? Theme.border-selected : Theme.border-subtle;
                                    animate background { duration: 150ms; }

                                    size100-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            AppState.search-page-size = 100;
                                            AppLogic.search-page-size-changed(100);
                                        }
                                    }

                                    HorizontalLayout {
                                        alignment: center;
                                        Text {
                                            text: "100";
                                            font-size: 12px;
                                            font-weight: 600;
                                            color: AppState.search-page-size == 100 ? #ffffff : Theme.text-primary;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // 4. Local Offline Cache
                SettingsSectionCard {
                    title: "💾 Local Offline Cache";
                    subtitle: "AURbreak stores latest package lists locally to provide rapid offline browsing and startup";

                    HorizontalLayout {
                        spacing: 16px;
                        alignment: space-between;

                        VerticalLayout {
                            spacing: 4px;
                            horizontal-stretch: 1;

                            HorizontalLayout {
                                spacing: 6px;
                                Text { text: "📁"; font-size: 12px; vertical-alignment: center; }
                                Text {
                                    text: AppState.cache-path != "" ? AppState.cache-path : "(XDG Data Directory)";
                                    font-size: 11px;
                                    font-weight: 500;
                                    color: Theme.text-primary;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }

                            Text {
                                text: AppState.cache-size-str != "" ? AppState.cache-size-str : "Atomic JSON storage with .bak backup recovery";
                                font-size: 11px;
                                color: Theme.text-secondary;
                            }
                        }

                        Rectangle {
                            height: 32px;
                            border-radius: 6px;
                            background: clear-touch.has-hover ? Theme.warning : Theme.section-bg;
                            border-width: 1px;
                            border-color: Theme.warning;
                            animate background { duration: 150ms; }

                            clear-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { AppLogic.clear-cache-requested(); }
                            }

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                alignment: center;
                                spacing: 6px;

                                Text {
                                    text: "🗑";
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: "Clear Cache";
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: clear-touch.has-hover ? #ffffff : Theme.warning;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // 5. Network & Official AUR Services
                SettingsSectionCard {
                    title: "🌐 Network & Official AUR Services";
                    subtitle: "Endpoints and official RPC v5 interface provided by the Arch User Repository";

                    VerticalLayout {
                        spacing: 10px;

                        HorizontalLayout {
                            alignment: space-between;

                            VerticalLayout {
                                spacing: 4px;

                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: "RPC v5 Base:";
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: Theme.text-secondary;
                                    }
                                    Text {
                                        text: "https://aur.archlinux.org/rpc/v5";
                                        font-size: 11px;
                                        color: Theme.text-primary;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: "RSS Feed:";
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: Theme.text-secondary;
                                    }
                                    Text {
                                        text: "https://aur.archlinux.org/rss/modified";
                                        font-size: 11px;
                                        color: Theme.text-primary;
                                    }
                                }
                            }

                            Rectangle {
                                height: 30px;
                                border-radius: 6px;
                                background: Theme.pill-bg;
                                border-width: 1px;
                                border-color: Theme.border-subtle;

                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { AppLogic.open-url("https://aur.archlinux.org/rpc/openapi.json"); }
                                }

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    alignment: center;
                                    spacing: 6px;
                                    Text {
                                        text: "↗ View OpenAPI Spec";
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: Theme.text-accent;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

                // 6. About AURbreak
                SettingsSectionCard {
                    title: "ℹ️ About AURbreak";
                    subtitle: "Desktop browser for Arch Linux User Repository (AUR)";

                    HorizontalLayout {
                        spacing: 16px;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 14px;
                            alignment: start;

                            Image {
                                source: @image-url("assets/aurbreak-icon-app.svg");
                                width: 44px;
                                height: 44px;
                            }

                            VerticalLayout {
                                spacing: 2px;
                                alignment: center;

                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: "AURbreak";
                                        font-size: 15px;
                                        font-weight: 700;
                                        color: Theme.text-primary;
                                    }
                                    Rectangle {
                                        height: 20px;
                                        border-radius: 4px;
                                        background: Theme.pill-bg;
                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            alignment: center;
                                            Text {
                                                text: "v" + AppState.app-version;
                                                font-size: 10px;
                                                font-weight: 600;
                                                color: Theme.text-secondary;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }

                                Text {
                                    text: "Built with Rust and Slint • Lightweight, seek-safe & native UI";
                                    font-size: 11px;
                                    color: Theme.text-secondary;
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;

                            // Arch Home link
                            Rectangle {
                                height: 30px;
                                border-radius: 6px;
                                background: Theme.pill-bg;
                                border-width: 1px;
                                border-color: Theme.border-subtle;

                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { AppLogic.open-url("https://archlinux.org"); }
                                }

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    alignment: center;
                                    Text {
                                        text: "Arch Linux ↗";
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: Theme.text-accent;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // AUR Home link
                            Rectangle {
                                height: 30px;
                                border-radius: 6px;
                                background: Theme.pill-bg;
                                border-width: 1px;
                                border-color: Theme.border-subtle;

                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { AppLogic.open-url("https://aur.archlinux.org"); }
                                }

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    alignment: center;
                                    Text {
                                        text: "AUR Portal ↗";
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: Theme.text-accent;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// Top Level Application Window
export component AppWindow inherits Window {
    title: "AURbreak — Arch Linux AUR Package Browser";
    icon: @image-url("assets/aurbreak-icon-app.svg");
    preferred-width: 1080px;
    preferred-height: 720px;
    min-width: 800px;
    min-height: 500px;
    background: Theme.window-bg;

    // Full-window FocusScope for keyboard shortcuts (e.g. Escape to close detail inspector)
    FocusScope {
        width: 100%;
        height: 100%;

        key-pressed(ev) => {
            if (ev.text == Key.Escape) {
                if (AppState.show-settings) {
                    AppLogic.close-settings();
                    return accept;
                }
                if (AppState.show-detail) {
                    AppLogic.close-detail();
                    return accept;
                }
            }
            // "/" focuses the search tab and positions cursor in the search input
            if (ev.text == "/") {
                if (!AppState.show-settings && AppState.active-tab != 2) {
                    AppLogic.tab-changed(2);
                    return accept;
                }
            }
            return reject;
        }

        // Main Vertical Layout
        VerticalLayout {
            width: 100%;
            height: 100%;
            padding: 14px;
            spacing: 12px;

            // Top Header Bar
            HorizontalLayout {
                height: 40px;
                vertical-stretch: 0;
                spacing: 16px;
                alignment: space-between;

                // App Brand / Logo with AURbreak icon
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;

                    Image {
                        source: @image-url("assets/aurbreak-icon-app.svg");
                        width: 34px;
                        height: 34px;
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;

                        Text {
                            text: "AURbreak";
                            font-size: 18px;
                            font-weight: 700;
                            color: Theme.text-primary;
                        }

                        Text {
                            text: AppState.last-fetched-str != "" ? "Updated: " + AppState.last-fetched-str : "Ready";
                            font-size: 11px;
                            color: Theme.text-secondary;
                        }
                    }
                }

                // Segmented Navigation Pill Tabs
                Rectangle {
                    height: 38px;
                    background: Theme.pill-bg;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    HorizontalLayout {
                        padding: 3px;
                        spacing: 4px;
                        alignment: center;

                        NavTab {
                            icon: "⚡";
                            title: "Last Modified";
                            active: AppState.active-tab == 0 && !AppState.show-settings;
                            clicked => {
                                AppState.show-settings = false;
                                AppLogic.tab-changed(0);
                            }
                        }

                        NavTab {
                            icon: "✨";
                            title: "Newest";
                            active: AppState.active-tab == 1 && !AppState.show-settings;
                            clicked => {
                                AppState.show-settings = false;
                                AppLogic.tab-changed(1);
                            }
                        }

                        NavTab {
                            icon: "🔍";
                            title: "Search AUR";
                            active: AppState.active-tab == 2 && !AppState.show-settings;
                            clicked => {
                                AppState.show-settings = false;
                                AppLogic.tab-changed(2);
                            }
                        }
                    }
                }

                // Right action buttons (Refresh + Settings)
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    // Refresh action button
                    Rectangle {
                        height: 34px;
                        background: refresh-touch.has-hover ? Theme.card-bg-hover : Theme.card-bg;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: Theme.border-default;
                        animate background { duration: 150ms; }

                        refresh-touch := TouchArea {
                            mouse-cursor: pointer;
                            enabled: !AppState.loading;
                            clicked => { AppLogic.refresh-requested(); }
                        }

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 6px;
                            alignment: center;

                            Text {
                                text: AppState.loading ? "⏳" : "↻";
                                font-size: 12px;
                                vertical-alignment: center;
                                color: AppState.loading ? Theme.text-muted : Theme.text-accent;
                            }

                            Text {
                                text: AppState.loading ? "Fetching…" : "Refresh";
                                font-size: 12px;
                                font-weight: 600;
                                color: AppState.loading ? Theme.text-muted : Theme.text-primary;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Settings action button
                    Rectangle {
                        height: 34px;
                        background: AppState.show-settings
                            ? Theme.pill-active-bg
                            : (settings-touch.has-hover ? Theme.card-bg-hover : Theme.card-bg);
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: AppState.show-settings ? Theme.border-selected : Theme.border-default;
                        animate background { duration: 150ms; }

                        settings-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.toggle-settings(); }
                        }

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 12px;
                            spacing: 6px;
                            alignment: center;

                            Text {
                                text: "⚙";
                                font-size: 13px;
                                color: AppState.show-settings ? #ffffff : Theme.text-primary;
                                vertical-alignment: center;
                            }

                            Text {
                                text: "Settings";
                                font-size: 12px;
                                font-weight: 600;
                                color: AppState.show-settings ? #ffffff : Theme.text-primary;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            // If settings is open, show SettingsView; otherwise show normal package explorer
            if AppState.show-settings: SettingsView {
                vertical-stretch: 1;
            }

            if !AppState.show-settings: VerticalLayout {
                vertical-stretch: 1;
                spacing: 12px;

                // Search Bar (Tab 2) OR Filter Bar (Tab 0 & 1)
                if AppState.active-tab == 2: SearchBar {
                vertical-stretch: 0;
                query <=> AppState.search-query;
                by <=> AppState.search-by;
                loading <=> AppState.search-loading;
                page <=> AppState.search-page;
                total-pages <=> AppState.search-total-pages;
                result-count <=> AppState.search-result-count;
                suggestions <=> AppState.suggestions;
                search-error <=> AppState.search-error;
                search-history <=> AppState.search-history;

                search-requested(query, by, page) => { AppLogic.search-requested(query, by, page); }
                page-changed(page) => { AppLogic.search-page-changed(page); }
                by-changed(by) => { AppLogic.search-by-changed(by); }
                get-suggestions(prefix) => { AppLogic.get-suggestions(prefix); }
                dismiss-suggestions() => { AppLogic.dismiss-suggestions(); }
                retry-search() => { AppLogic.retry-search(); }
                clear-history() => { AppLogic.clear-search-history(); }
            }

            if AppState.active-tab != 2: HorizontalLayout {
                height: 34px;
                vertical-stretch: 0;
                spacing: 12px;

                filter-input := LineEdit {
                    text <=> AppState.search-filter;
                    placeholder-text: "Filter packages by name, description, or maintainer…";
                    horizontal-stretch: 1;
                    edited => {
                        AppLogic.filter-changed(self.text);
                    }
                }

                if AppState.search-filter != "": Button {
                    text: "✕ Clear";
                    clicked => {
                        AppState.search-filter = "";
                        AppLogic.filter-changed("");
                    }
                }

                // Count badge
                Rectangle {
                    background: Theme.card-bg;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: Theme.border-default;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        alignment: center;

                        Text {
                            text: AppState.search-filter != ""
                                ? "Showing " + AppState.displayed-items-count + " of " + AppState.total-items-count
                                : AppState.total-items-count + " packages";
                            font-size: 12px;
                            font-weight: 500;
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Loading Progress Indicator
            if AppState.loading: ProgressIndicator {
                indeterminate: true;
                height: 3px;
                vertical-stretch: 0;
            }

            // Main Content Area: Package List (left) + Package Detail Pane (right)
            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 12px;

                // Scrollable Package List
                ScrollView {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    horizontal-scrollbar-policy: always-off;

                    VerticalLayout {
                        padding-right: 8px;
                        padding-bottom: 8px;
                        spacing: 8px;
                        alignment: start;

                        for pkg in AppState.packages: PackageCard {
                            pkg: pkg;
                            selected: AppState.show-detail && AppState.detail-name == pkg.name;
                        }

                        // Empty state card when no packages are found
                        if AppState.packages.length == 0 && !AppState.loading: Rectangle {
                            height: 220px;
                            background: Theme.card-bg;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border-default;

                            VerticalLayout {
                                alignment: center;
                                spacing: 10px;

                                Text {
                                    text: "📦";
                                    font-size: 36px;
                                    horizontal-alignment: center;
                                }

                                Text {
                                    text: AppState.active-tab == 2
                                        ? (AppState.search-query == "" ? "Enter a package name or keyword above to search AUR" : "No packages found matching \"" + AppState.search-query + "\"")
                                        : (AppState.search-filter != "" ? "No packages match filter \"" + AppState.search-filter + "\"" : "No packages available. Click Refresh to fetch latest items.");
                                    font-size: 13px;
                                    font-weight: 500;
                                    color: Theme.text-secondary;
                                    horizontal-alignment: center;
                                }

                                if AppState.search-filter != "": HorizontalLayout {
                                    alignment: center;
                                    Button {
                                        text: "Clear filter";
                                        clicked => {
                                            AppState.search-filter = "";
                                            AppLogic.filter-changed("");
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Package Detail Pane (Inspector)
                if AppState.show-detail: PackageDetail {
                    horizontal-stretch: 0;
                    width: 420px;
                    name: AppState.detail-name;
                    version: AppState.detail-version;
                    description: AppState.detail-description;
                    maintainer: AppState.detail-maintainer;
                    votes: AppState.detail-votes;
                    popularity: AppState.detail-popularity;
                    url: AppState.detail-url;
                    license: AppState.detail-license;
                    depends: AppState.detail-depends;
                    make-depends: AppState.detail-make-depends;
                    opt-depends: AppState.detail-opt-depends;
                    check-depends: AppState.detail-check-depends;
                    provides: AppState.detail-provides;
                    conflicts: AppState.detail-conflicts;
                    replaces: AppState.detail-replaces;
                    groups: AppState.detail-groups;
                    keywords: AppState.detail-keywords;
                    co-maintainers: AppState.detail-co-maintainers;
                    first-submitted: AppState.detail-first-submitted;
                    last-modified: AppState.detail-last-modified;
                    out-of-date: AppState.detail-out-of-date;
                    submitter: AppState.detail-submitter;
                }
            }
        }

            // Footer Status Bar
            HorizontalLayout {
                height: 22px;
                vertical-stretch: 0;
                spacing: 12px;
                alignment: space-between;

                Text {
                    text: AppState.status-text;
                    font-size: 11px;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                }

                HorizontalLayout {
                    spacing: 12px;
                    alignment: end;

                    Text {
                        text: AppState.show-settings
                            ? "Esc or ← to exit settings"
                            : (AppState.show-detail ? "Esc or ✕ to close inspector • Click cards to inspect" : "Click package card to inspect details");
                        font-size: 11px;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
