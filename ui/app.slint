import { Button, LineEdit, ScrollView, ProgressIndicator, Palette, ComboBox } from "std-widgets.slint";

export struct PackageItem {
    name: string,
    version: string,
    votes: int,
    popularity: string,
    description: string,
    maintainer: string,
    updated: string,
}

// Global Theme: semantic tokens for dark and light modes
export global Theme {
    in-out property <bool> force-dark: false;
    out property <bool> dark: force-dark || Palette.color-scheme == ColorScheme.dark;

    // Backgrounds
    out property <color> window-bg: dark ? #0b0f19 : #f8fafc;
    out property <color> header-bg: dark ? #111827 : #ffffff;
    out property <color> card-bg: dark ? #131d2e : #ffffff;
    out property <color> card-bg-hover: dark ? #1a273e : #f1f5f9;
    out property <color> card-bg-selected: dark ? #1e2e4f : #e0f2fe;
    out property <color> pill-bg: dark ? #1e293b : #f1f5f9;
    out property <color> pill-active-bg: dark ? #0284c7 : #0284c7;
    out property <color> code-bg: dark ? #070b12 : #f1f5f9;
    out property <color> section-bg: dark ? #0e1626 : #f8fafc;

    // Borders
    out property <color> border-subtle: dark ? #1e293b : #e2e8f0;
    out property <color> border-default: dark ? #25334c : #cbd5e1;
    out property <color> border-hover: dark ? #3b4d71 : #94a3b8;
    out property <color> border-selected: dark ? #38bdf8 : #0284c7;

    // Typography
    out property <color> text-primary: dark ? #f8fafc : #0f172a;
    out property <color> text-secondary: dark ? #94a3b8 : #475569;
    out property <color> text-muted: dark ? #64748b : #64748b;
    out property <color> text-accent: dark ? #38bdf8 : #0284c7;
    out property <color> text-date: dark ? #c084fc : #7e22ce;

    // Accents & Badges
    out property <color> vote-color: #10b981;
    out property <color> pop-color: #f59e0b;
    out property <color> warning: #f43f5e;
    out property <color> warning-bg: dark ? #2d121c : #ffe4e6;
    out property <color> badge-vote-bg: dark ? #06281e : #ecfdf5;
    out property <color> badge-pop-bg: dark ? #2a1b08 : #fffbeb;
}

// Global state pushed from Rust
export global AppState {
    in-out property <[PackageItem]> packages: [];
    in-out property <bool> loading: false;
    in-out property <string> status-text: "Ready";
    in-out property <int> active-tab: 0; // 0 = Last Updated, 1 = Newest Submissions, 2 = Search
    in-out property <string> last-fetched-str: "";
    in-out property <string> search-filter: "";
    in-out property <int> total-items-count: 0;
    in-out property <int> displayed-items-count: 0;

    // Search tab state
    in-out property <string> search-query: "";
    in-out property <int> search-by: 1; // default to name-desc (index 1)
    in-out property <int> search-page: 1;
    in-out property <int> search-total-pages: 1;
    in-out property <int> search-result-count: 0;
    in-out property <bool> search-loading: false;
    in-out property <[string]> suggestions: [];

    // Detail view state
    in-out property <bool> show-detail: false;
    in-out property <string> detail-name: "";
    in-out property <string> detail-version: "";
    in-out property <string> detail-description: "";
    in-out property <string> detail-maintainer: "";
    in-out property <int> detail-votes: 0;
    in-out property <float> detail-popularity: 0.0;
    in-out property <string> detail-url: "";
    in-out property <string> detail-license: "";
    in-out property <[string]> detail-depends: [];
    in-out property <[string]> detail-make-depends: [];
    in-out property <[string]> detail-opt-depends: [];
    in-out property <[string]> detail-check-depends: [];
    in-out property <[string]> detail-provides: [];
    in-out property <[string]> detail-conflicts: [];
    in-out property <[string]> detail-replaces: [];
    in-out property <[string]> detail-groups: [];
    in-out property <[string]> detail-keywords: [];
    in-out property <[string]> detail-co-maintainers: [];
    in-out property <string> detail-first-submitted: "";
    in-out property <string> detail-last-modified: "";
    in-out property <string> detail-out-of-date: "";
    in-out property <string> detail-submitter: "";
}

// Global logic callbacks handled by Rust
export global AppLogic {
    callback refresh-requested();
    callback open-pkg-page(string);
    callback tab-changed(int);

    // Search callbacks
    callback search-requested(string, int, int);
    callback search-page-changed(int);
    callback search-by-changed(int);
    callback get-suggestions(string);

    // Filter callback
    callback filter-changed(string);

    // Detail view callbacks
    callback show-package-detail(string);
    callback close-detail();
}

// Navigation Tab Component
component NavTab inherits Rectangle {
    in property <string> title;
    in property <string> icon;
    in property <bool> active: false;
    callback clicked();

    height: 32px;
    border-radius: 6px;
    background: root.active ? Theme.card-bg : (touch.has-hover ? Theme.card-bg-hover : Colors.transparent);
    border-width: root.active ? 1px : 0px;
    border-color: Theme.border-subtle;

    animate background { duration: 150ms; }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 6px;
        alignment: center;

        Text {
            text: root.icon;
            font-size: 13px;
            vertical-alignment: center;
        }

        Text {
            text: root.title;
            font-size: 13px;
            font-weight: root.active ? 600 : 500;
            color: root.active ? Theme.text-accent : (touch.has-hover ? Theme.text-primary : Theme.text-secondary);
            vertical-alignment: center;
        }
    }
}

// Package Card in the main list
component PackageCard inherits Rectangle {
    in property <PackageItem> pkg;
    in property <bool> selected: false;

    vertical-stretch: 0;
    background: root.selected
        ? Theme.card-bg-selected
        : (touch.has-hover ? Theme.card-bg-hover : Theme.card-bg);
    border-radius: 8px;
    border-width: 1px;
    border-color: root.selected
        ? Theme.border-selected
        : (touch.has-hover ? Theme.border-hover : Theme.border-default);

    animate background { duration: 150ms; }
    animate border-color { duration: 150ms; }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { AppLogic.show-package-detail(root.pkg.name); }
    }

    VerticalLayout {
        padding: 12px;
        spacing: 6px;
        alignment: start;

        // Row 1: Name, Version badge, Maintainer, Updated Date
        HorizontalLayout {
            height: 24px;
            vertical-stretch: 0;
            spacing: 8px;

            Text {
                text: root.pkg.name;
                font-size: 15px;
                font-weight: 700;
                color: Theme.text-accent;
                vertical-alignment: center;
            }

            Rectangle {
                height: 22px;
                vertical-stretch: 0;
                background: Theme.pill-bg;
                border-radius: 4px;
                border-width: 1px;
                border-color: Theme.border-subtle;
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    alignment: center;
                    Text {
                        text: "v" + root.pkg.version;
                        font-size: 11px;
                        font-weight: 500;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                    }
                }
            }

            Rectangle { horizontal-stretch: 1; }

            if root.pkg.maintainer != "": HorizontalLayout {
                spacing: 4px;
                Text {
                    text: "👤";
                    font-size: 11px;
                    vertical-alignment: center;
                }
                Text {
                    text: root.pkg.maintainer;
                    font-size: 11px;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                }
            }

            HorizontalLayout {
                spacing: 4px;
                Text {
                    text: "🕒";
                    font-size: 11px;
                    vertical-alignment: center;
                }
                Text {
                    text: root.pkg.updated;
                    font-size: 11px;
                    font-weight: 500;
                    color: Theme.text-date;
                    vertical-alignment: center;
                }
            }
        }

        // Row 2: Description
        Text {
            text: root.pkg.description != "" ? root.pkg.description : "(no description provided)";
            font-size: 12px;
            color: Theme.text-secondary;
            wrap: word-wrap;
            max-height: 36px;
            vertical-stretch: 0;
        }

        // Row 3: Stats (Votes, Popularity) & Action prompt
        HorizontalLayout {
            height: 24px;
            vertical-stretch: 0;
            spacing: 10px;

            if root.pkg.votes > 0: Rectangle {
                height: 22px;
                vertical-stretch: 0;
                background: Theme.badge-vote-bg;
                border-radius: 4px;
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 4px;
                    alignment: center;
                    Text {
                        text: "▲";
                        font-size: 10px;
                        color: Theme.vote-color;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.pkg.votes + " votes";
                        font-size: 11px;
                        font-weight: 600;
                        color: Theme.vote-color;
                        vertical-alignment: center;
                    }
                }
            }

            if root.pkg.popularity != "": Rectangle {
                height: 22px;
                vertical-stretch: 0;
                background: Theme.badge-pop-bg;
                border-radius: 4px;
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 4px;
                    alignment: center;
                    Text {
                        text: "★";
                        font-size: 10px;
                        color: Theme.pop-color;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.pkg.popularity + " pop";
                        font-size: 11px;
                        font-weight: 600;
                        color: Theme.pop-color;
                        vertical-alignment: center;
                    }
                }
            }

            Rectangle { horizontal-stretch: 1; }

            Text {
                text: touch.has-hover ? "Inspect package →" : "";
                font-size: 11px;
                font-weight: 600;
                color: Theme.text-accent;
                vertical-alignment: center;
            }
        }
    }
}

// Search bar component for the Search tab
component SearchBar inherits Rectangle {
    in-out property <string> query: "";
    in-out property <int> by: 1;
    in-out property <bool> loading: false;
    in-out property <int> page: 1;
    in-out property <int> total-pages: 1;
    in-out property <int> result-count: 0;
    in-out property <[string]> suggestions: [];

    callback search-requested(string, int, int);
    callback page-changed(int);
    callback by-changed(int);
    callback get-suggestions(string);

    vertical-stretch: 0;
    background: Theme.card-bg;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.border-default;

    VerticalLayout {
        padding: 10px;
        spacing: 8px;
        alignment: start;

        // Row 1: Search LineEdit, SearchBy Dropdown, Search Button
        HorizontalLayout {
            height: 34px;
            vertical-stretch: 0;
            spacing: 8px;

            search-input := LineEdit {
                text <=> root.query;
                placeholder-text: "Search AUR packages (e.g. google-chrome, spotify, yay)…";
                horizontal-stretch: 1;
                edited => {
                    root.get-suggestions(root.query);
                }
                accepted => {
                    if (root.query != "" && !root.loading) {
                        root.search-requested(root.query, root.by, 1);
                    }
                }
            }

            ComboBox {
                model: ["Name & Desc", "Name only", "Depends", "Check Depends", "Opt Depends", "Make Depends", "Maintainer", "Submitter"];
                current-index <=> root.by;
                width: 140px;
                selected(val) => {
                    root.by-changed(root.by);
                }
            }

            Button {
                text: root.loading ? "Searching…" : "Search";
                enabled: !root.loading && root.query != "";
                primary: true;
                clicked => { root.search-requested(root.query, root.by, 1); }
            }
        }

        // Row 2: Results info & Pagination (visible if results exist)
        if root.result-count > 0: HorizontalLayout {
            height: 30px;
            vertical-stretch: 0;
            spacing: 12px;
            alignment: space-between;

            Text {
                text: "Found " + root.result-count + " package" + (root.result-count == 1 ? "" : "s");
                font-size: 12px;
                font-weight: 500;
                color: Theme.text-secondary;
                vertical-alignment: center;
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: end;

                Button {
                    text: "◀ Prev";
                    enabled: root.page > 1 && !root.loading;
                    clicked => { root.page-changed(root.page - 1); }
                }

                Text {
                    text: "Page " + root.page + " of " + root.total-pages;
                    font-size: 12px;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                }

                Button {
                    text: "Next ▶";
                    enabled: root.page < root.total-pages && !root.loading;
                    clicked => { root.page-changed(root.page + 1); }
                }
            }
        }
    }
}

// Package Detail Pane (Inspector)
component PackageDetail inherits Rectangle {
    in property <string> name: "";
    in property <string> version: "";
    in property <string> description: "";
    in property <string> maintainer: "";
    in property <int> votes: 0;
    in property <float> popularity: 0.0;
    in property <string> url: "";
    in property <string> license: "";
    in property <[string]> depends: [];
    in property <[string]> make-depends: [];
    in property <[string]> opt-depends: [];
    in property <[string]> check-depends: [];
    in property <[string]> provides: [];
    in property <[string]> conflicts: [];
    in property <[string]> replaces: [];
    in property <[string]> groups: [];
    in property <[string]> keywords: [];
    in property <[string]> co-maintainers: [];
    in property <string> first-submitted: "";
    in property <string> last-modified: "";
    in property <string> out-of-date: "";
    in property <string> submitter: "";

    background: Theme.card-bg;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.border-default;
    clip: true;

    // Outer layout containing header, divider, and scrollable content
    VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: 0px;

        // Detail Header
        Rectangle {
            height: 48px;
            vertical-stretch: 0;
            background: Theme.header-bg;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 8px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: root.name;
                        font-size: 16px;
                        font-weight: 700;
                        color: Theme.text-accent;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    Rectangle {
                        height: 22px;
                        background: Theme.pill-bg;
                        border-radius: 4px;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            alignment: center;
                            Text {
                                text: "v" + root.version;
                                font-size: 11px;
                                color: Theme.text-secondary;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    // Open on AUR website button
                    Rectangle {
                        height: 28px;
                        border-radius: 6px;
                        background: web-touch.has-hover ? Theme.card-bg-hover : Theme.pill-bg;
                        border-width: 1px;
                        border-color: Theme.border-subtle;
                        animate background { duration: 150ms; }

                        web-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.open-pkg-page(root.name); }
                        }

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 4px;
                            alignment: center;
                            Text {
                                text: "AUR ↗";
                                font-size: 11px;
                                font-weight: 600;
                                color: Theme.text-accent;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Close button
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 6px;
                        background: close-touch.has-hover ? Theme.card-bg-hover : Theme.pill-bg;
                        border-width: 1px;
                        border-color: Theme.border-subtle;
                        animate background { duration: 150ms; }

                        close-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.close-detail(); }
                        }

                        Text {
                            text: "✕";
                            font-size: 12px;
                            font-weight: 600;
                            color: Theme.text-secondary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Thin separator line
        Rectangle {
            height: 1px;
            vertical-stretch: 0;
            background: Theme.border-subtle;
        }

        // Scrollable Body
        ScrollView {
            vertical-stretch: 1;
            horizontal-scrollbar-policy: always-off;

            VerticalLayout {
                padding: 14px;
                spacing: 12px;
                alignment: start;

                // Quick Install Snippet
                Rectangle {
                    background: Theme.code-bg;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 4px;

                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            Text {
                                text: ">_";
                                font-size: 12px;
                                font-weight: 700;
                                color: Theme.text-accent;
                            }
                            Text {
                                text: "yay -S " + root.name;
                                font-size: 12px;
                                font-weight: 600;
                                color: Theme.text-primary;
                            }
                        }

                        Text {
                            text: "Install with yay or your preferred AUR helper";
                            font-size: 10px;
                            color: Theme.text-muted;
                        }
                    }
                }

                // Out of date warning banner if applicable
                if root.out-of-date != "": Rectangle {
                    background: Theme.warning-bg;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: Theme.warning;

                    HorizontalLayout {
                        padding: 10px;
                        spacing: 8px;
                        alignment: start;

                        Text {
                            text: "⚠️";
                            font-size: 14px;
                            vertical-alignment: center;
                        }

                        VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: "Flagged Out-of-Date";
                                font-size: 12px;
                                font-weight: 700;
                                color: Theme.warning;
                            }
                            Text {
                                text: "Date: " + root.out-of-date;
                                font-size: 11px;
                                color: Theme.text-secondary;
                            }
                        }
                    }
                }

                // Description
                VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: "DESCRIPTION";
                        font-size: 10px;
                        font-weight: 700;
                        color: Theme.text-muted;
                    }
                    Text {
                        text: root.description != "" ? root.description : "(No description provided)";
                        font-size: 13px;
                        color: Theme.text-primary;
                        wrap: word-wrap;
                    }
                }

                // Key Stats & Metadata Grid
                Rectangle {
                    background: Theme.section-bg;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 8px;

                        // Row 1: Votes & Popularity
                        HorizontalLayout {
                            spacing: 12px;

                            HorizontalLayout {
                                spacing: 4px;
                                horizontal-stretch: 1;
                                Text { text: "▲"; font-size: 11px; color: Theme.vote-color; vertical-alignment: center; }
                                Text { text: root.votes + " votes"; font-size: 12px; font-weight: 600; color: Theme.vote-color; vertical-alignment: center; }
                            }

                            HorizontalLayout {
                                spacing: 4px;
                                horizontal-stretch: 1;
                                Text { text: "★"; font-size: 11px; color: Theme.pop-color; vertical-alignment: center; }
                                Text { text: root.popularity + " pop"; font-size: 12px; font-weight: 600; color: Theme.pop-color; vertical-alignment: center; }
                            }
                        }

                        // Row 2: Maintainer & Submitter
                        HorizontalLayout {
                            spacing: 12px;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: "MAINTAINER"; font-size: 9px; font-weight: 600; color: Theme.text-muted; }
                                Text { text: root.maintainer != "" ? root.maintainer : "(orphan / none)"; font-size: 12px; color: Theme.text-primary; }
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: "SUBMITTER"; font-size: 9px; font-weight: 600; color: Theme.text-muted; }
                                Text { text: root.submitter != "" ? root.submitter : "unknown"; font-size: 12px; color: Theme.text-primary; }
                            }
                        }

                        // Row 3: Timestamps
                        HorizontalLayout {
                            spacing: 12px;

                            if root.last-modified != "": VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: "LAST MODIFIED"; font-size: 9px; font-weight: 600; color: Theme.text-muted; }
                                Text { text: root.last-modified; font-size: 11px; color: Theme.text-secondary; }
                            }

                            if root.first-submitted != "": VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: "FIRST SUBMITTED"; font-size: 9px; font-weight: 600; color: Theme.text-muted; }
                                Text { text: root.first-submitted; font-size: 11px; color: Theme.text-secondary; }
                            }
                        }
                    }
                }

                // License
                if root.license != "": VerticalLayout {
                    spacing: 4px;
                    Text { text: "LICENSE"; font-size: 10px; font-weight: 700; color: Theme.text-muted; }
                    Text { text: root.license; font-size: 12px; color: Theme.text-primary; wrap: word-wrap; }
                }

                // Dependencies
                if root.depends.length > 0: VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: "DEPENDENCIES (" + root.depends.length + ")";
                        font-size: 10px;
                        font-weight: 700;
                        color: Theme.text-muted;
                    }

                    VerticalLayout {
                        spacing: 4px;
                        for dep in root.depends: Rectangle {
                            height: 26px;
                            background: Theme.pill-bg;
                            border-radius: 4px;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                alignment: start;
                                Text {
                                    text: "• " + dep;
                                    font-size: 12px;
                                    color: Theme.text-secondary;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // Make Dependencies
                if root.make-depends.length > 0: VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: "MAKE DEPENDENCIES (" + root.make-depends.length + ")";
                        font-size: 10px;
                        font-weight: 700;
                        color: Theme.text-muted;
                    }

                    VerticalLayout {
                        spacing: 4px;
                        for dep in root.make-depends: Rectangle {
                            height: 26px;
                            background: Theme.pill-bg;
                            border-radius: 4px;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                alignment: start;
                                Text {
                                    text: "• " + dep;
                                    font-size: 12px;
                                    color: Theme.text-secondary;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // Optional Dependencies
                if root.opt-depends.length > 0: VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: "OPTIONAL DEPENDENCIES (" + root.opt-depends.length + ")";
                        font-size: 10px;
                        font-weight: 700;
                        color: Theme.text-muted;
                    }

                    VerticalLayout {
                        spacing: 4px;
                        for dep in root.opt-depends: Rectangle {
                            height: 26px;
                            background: Theme.pill-bg;
                            border-radius: 4px;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                alignment: start;
                                Text {
                                    text: "• " + dep;
                                    font-size: 12px;
                                    color: Theme.text-secondary;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // Provides
                if root.provides.length > 0: VerticalLayout {
                    spacing: 6px;
                    Text { text: "PROVIDES"; font-size: 10px; font-weight: 700; color: Theme.text-muted; }
                    VerticalLayout {
                        spacing: 4px;
                        for item in root.provides: Rectangle {
                            height: 26px;
                            background: Theme.pill-bg;
                            border-radius: 4px;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                alignment: start;
                                Text { text: "• " + item; font-size: 12px; color: Theme.text-secondary; vertical-alignment: center; }
                            }
                        }
                    }
                }

                // Conflicts
                if root.conflicts.length > 0: VerticalLayout {
                    spacing: 6px;
                    Text { text: "CONFLICTS"; font-size: 10px; font-weight: 700; color: Theme.text-muted; }
                    VerticalLayout {
                        spacing: 4px;
                        for item in root.conflicts: Rectangle {
                            height: 26px;
                            background: Theme.pill-bg;
                            border-radius: 4px;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                alignment: start;
                                Text { text: "• " + item; font-size: 12px; color: Theme.text-secondary; vertical-alignment: center; }
                            }
                        }
                    }
                }
            }
        }
    }
}

// Top Level Application Window
export component AppWindow inherits Window {
    title: "Browse Arch — Arch Linux AUR Package Browser";
    preferred-width: 1080px;
    preferred-height: 720px;
    min-width: 800px;
    min-height: 500px;
    background: Theme.window-bg;

    // Full-window FocusScope for keyboard shortcuts (e.g. Escape to close detail inspector)
    FocusScope {
        width: 100%;
        height: 100%;

        key-pressed(ev) => {
            if (ev.text == Key.Escape) {
                if (AppState.show-detail) {
                    AppLogic.close-detail();
                    return accept;
                }
            }
            return reject;
        }

        // Main Vertical Layout
        VerticalLayout {
            width: 100%;
            height: 100%;
            padding: 14px;
            spacing: 12px;

            // Top Header Bar
            HorizontalLayout {
                height: 40px;
                vertical-stretch: 0;
                spacing: 16px;
                alignment: space-between;

                // App Brand / Logo
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;

                    // Arch AUR Badge
                    Rectangle {
                        width: 44px;
                        height: 32px;
                        border-radius: 6px;
                        background: @linear-gradient(135deg, #0284c7 0%, #0369a1 100%);

                        Text {
                            text: "AUR";
                            font-size: 12px;
                            font-weight: 800;
                            color: #ffffff;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;

                        Text {
                            text: "Browse Arch";
                            font-size: 17px;
                            font-weight: 700;
                            color: Theme.text-primary;
                        }

                        Text {
                            text: AppState.last-fetched-str != "" ? "Updated: " + AppState.last-fetched-str : "Ready";
                            font-size: 11px;
                            color: Theme.text-secondary;
                        }
                    }
                }

                // Segmented Navigation Pill Tabs
                Rectangle {
                    height: 38px;
                    background: Theme.pill-bg;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    HorizontalLayout {
                        padding: 3px;
                        spacing: 4px;
                        alignment: center;

                        NavTab {
                            icon: "⚡";
                            title: "Last Modified";
                            active: AppState.active-tab == 0;
                            clicked => { AppLogic.tab-changed(0); }
                        }

                        NavTab {
                            icon: "✨";
                            title: "Newest";
                            active: AppState.active-tab == 1;
                            clicked => { AppLogic.tab-changed(1); }
                        }

                        NavTab {
                            icon: "🔍";
                            title: "Search AUR";
                            active: AppState.active-tab == 2;
                            clicked => { AppLogic.tab-changed(2); }
                        }
                    }
                }

                // Refresh action button
                Rectangle {
                    height: 34px;
                    background: refresh-touch.has-hover ? Theme.card-bg-hover : Theme.card-bg;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: Theme.border-default;
                    animate background { duration: 150ms; }

                    refresh-touch := TouchArea {
                        mouse-cursor: pointer;
                        enabled: !AppState.loading;
                        clicked => { AppLogic.refresh-requested(); }
                    }

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 6px;
                        alignment: center;

                        Text {
                            text: AppState.loading ? "⏳" : "↻";
                            font-size: 12px;
                            vertical-alignment: center;
                            color: AppState.loading ? Theme.text-muted : Theme.text-accent;
                        }

                        Text {
                            text: AppState.loading ? "Fetching…" : "Refresh";
                            font-size: 12px;
                            font-weight: 600;
                            color: AppState.loading ? Theme.text-muted : Theme.text-primary;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Search Bar (Tab 2) OR Filter Bar (Tab 0 & 1)
            if AppState.active-tab == 2: SearchBar {
                vertical-stretch: 0;
                query <=> AppState.search-query;
                by <=> AppState.search-by;
                loading <=> AppState.search-loading;
                page <=> AppState.search-page;
                total-pages <=> AppState.search-total-pages;
                result-count <=> AppState.search-result-count;
                suggestions <=> AppState.suggestions;

                search-requested(query, by, page) => { AppLogic.search-requested(query, by, page); }
                page-changed(page) => { AppLogic.search-page-changed(page); }
                by-changed(by) => { AppLogic.search-by-changed(by); }
                get-suggestions(prefix) => { AppLogic.get-suggestions(prefix); }
            }

            if AppState.active-tab != 2: HorizontalLayout {
                height: 34px;
                vertical-stretch: 0;
                spacing: 12px;

                filter-input := LineEdit {
                    text <=> AppState.search-filter;
                    placeholder-text: "Filter packages by name, description, or maintainer…";
                    horizontal-stretch: 1;
                    edited => {
                        AppLogic.filter-changed(self.text);
                    }
                }

                if AppState.search-filter != "": Button {
                    text: "✕ Clear";
                    clicked => {
                        AppState.search-filter = "";
                        AppLogic.filter-changed("");
                    }
                }

                // Count badge
                Rectangle {
                    background: Theme.card-bg;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: Theme.border-default;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        alignment: center;

                        Text {
                            text: AppState.search-filter != ""
                                ? "Showing " + AppState.displayed-items-count + " of " + AppState.total-items-count
                                : AppState.total-items-count + " packages";
                            font-size: 12px;
                            font-weight: 500;
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Loading Progress Indicator
            if AppState.loading: ProgressIndicator {
                indeterminate: true;
                height: 3px;
                vertical-stretch: 0;
            }

            // Main Content Area: Package List (left) + Package Detail Pane (right)
            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 12px;

                // Scrollable Package List
                ScrollView {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    horizontal-scrollbar-policy: always-off;

                    VerticalLayout {
                        padding-right: 8px;
                        padding-bottom: 8px;
                        spacing: 8px;
                        alignment: start;

                        for pkg in AppState.packages: PackageCard {
                            pkg: pkg;
                            selected: AppState.show-detail && AppState.detail-name == pkg.name;
                        }

                        // Empty state card when no packages are found
                        if AppState.packages.length == 0 && !AppState.loading: Rectangle {
                            height: 220px;
                            background: Theme.card-bg;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border-default;

                            VerticalLayout {
                                alignment: center;
                                spacing: 10px;

                                Text {
                                    text: "📦";
                                    font-size: 36px;
                                    horizontal-alignment: center;
                                }

                                Text {
                                    text: AppState.active-tab == 2
                                        ? (AppState.search-query == "" ? "Enter a package name or keyword above to search AUR" : "No packages found matching \"" + AppState.search-query + "\"")
                                        : (AppState.search-filter != "" ? "No packages match filter \"" + AppState.search-filter + "\"" : "No packages available. Click Refresh to fetch latest items.");
                                    font-size: 13px;
                                    font-weight: 500;
                                    color: Theme.text-secondary;
                                    horizontal-alignment: center;
                                }

                                if AppState.search-filter != "": HorizontalLayout {
                                    alignment: center;
                                    Button {
                                        text: "Clear filter";
                                        clicked => {
                                            AppState.search-filter = "";
                                            AppLogic.filter-changed("");
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Package Detail Pane (Inspector)
                if AppState.show-detail: PackageDetail {
                    horizontal-stretch: 0;
                    width: 420px;
                    name: AppState.detail-name;
                    version: AppState.detail-version;
                    description: AppState.detail-description;
                    maintainer: AppState.detail-maintainer;
                    votes: AppState.detail-votes;
                    popularity: AppState.detail-popularity;
                    url: AppState.detail-url;
                    license: AppState.detail-license;
                    depends: AppState.detail-depends;
                    make-depends: AppState.detail-make-depends;
                    opt-depends: AppState.detail-opt-depends;
                    check-depends: AppState.detail-check-depends;
                    provides: AppState.detail-provides;
                    conflicts: AppState.detail-conflicts;
                    replaces: AppState.detail-replaces;
                    groups: AppState.detail-groups;
                    keywords: AppState.detail-keywords;
                    co-maintainers: AppState.detail-co-maintainers;
                    first-submitted: AppState.detail-first-submitted;
                    last-modified: AppState.detail-last-modified;
                    out-of-date: AppState.detail-out-of-date;
                    submitter: AppState.detail-submitter;
                }
            }

            // Footer Status Bar
            HorizontalLayout {
                height: 22px;
                vertical-stretch: 0;
                spacing: 12px;
                alignment: space-between;

                Text {
                    text: AppState.status-text;
                    font-size: 11px;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                }

                HorizontalLayout {
                    spacing: 12px;
                    alignment: end;

                    Text {
                        text: AppState.show-detail ? "Esc or ✕ to close inspector • Click cards to inspect" : "Click package card to inspect details";
                        font-size: 11px;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
