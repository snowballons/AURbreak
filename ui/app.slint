import { Button, LineEdit, ScrollView, VerticalBox, HorizontalBox, ProgressIndicator, Palette } from "std-widgets.slint";

export struct PackageItem {
    name: string,
    version: string,
    votes: int,
    popularity: string,
    description: string,
    maintainer: string,
    updated: string,
}

// Global Theme: derives semantic colors from `Palette` so dark/light mode
// transitions happen automatically based on OS theme (icons-and-theming rule).
export global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;

    // Palette tokens
    out property <color> window-bg: dark ? #0f172a : #f8fafc;
    out property <color> card-bg: dark ? #1e293b : #ffffff;
    out property <color> card-bg-hover: dark ? #334155 : #f1f5f9;
    out property <color> card-border: dark ? #334155 : #e2e8f0;

    out property <color> text-primary: dark ? #f8fafc : #0f172a;
    out property <color> text-secondary: dark ? #94a3b8 : #64748b;
    out property <color> text-accent: dark ? #38bdf8 : #0284c7;
    out property <color> text-date: dark ? #c084fc : #7e22ce;

    out property <color> vote-color: #16a34a;
    out property <color> pop-color: #d97706;
    out property <color> warning: #f59e0b;
}

// Global state pushed from Rust (interop.md pattern).
export global AppState {
    in-out property <[PackageItem]> packages: [];
    in-out property <bool> loading: false;
    in-out property <string> status-text: "Ready";
    in-out property <int> active-tab: 0; // 0 = Last Updated, 1 = Newest Submissions, 2 = Search
    in-out property <string> last-fetched-str: "";
    in-out property <string> search-filter: "";

    // Search tab state
    in-out property <string> search-query: "";
    in-out property <int> search-by: 1; // default to name-desc (index 1)
    in-out property <int> search-page: 1;
    in-out property <int> search-total-pages: 1;
    in-out property <int> search-result-count: 0;
    in-out property <bool> search-loading: false;
    in-out property <[string]> suggestions: [];

    // Detail view state (Phase 2)
    in-out property <bool> show-detail: false;
    in-out property <string> detail-name: "";
    in-out property <string> detail-version: "";
    in-out property <string> detail-description: "";
    in-out property <string> detail-maintainer: "";
    in-out property <int> detail-votes: 0;
    in-out property <float> detail-popularity: 0.0;
    in-out property <string> detail-url: "";
    in-out property <string> detail-license: "";
    in-out property <[string]> detail-depends: [];
    in-out property <[string]> detail-make-depends: [];
    in-out property <[string]> detail-opt-depends: [];
    in-out property <[string]> detail-check-depends: [];
    in-out property <[string]> detail-provides: [];
    in-out property <[string]> detail-conflicts: [];
    in-out property <[string]> detail-replaces: [];
    in-out property <[string]> detail-groups: [];
    in-out property <[string]> detail-keywords: [];
    in-out property <[string]> detail-co-maintainers: [];
    in-out property <string> detail-first-submitted: "";
    in-out property <string> detail-last-modified: "";
    in-out property <string> detail-out-of-date: "";
    in-out property <string> detail-submitter: "";
}

// Global logic callbacks handled by Rust.
export global AppLogic {
    callback refresh-requested();
    callback open-pkg-page(string);
    callback tab-changed(int);

    // Search callbacks
    callback search-requested(string, int, int);
    callback search-page-changed(int);
    callback search-by-changed(int);
    callback get-suggestions(string);

    // Detail view callbacks (Phase 2)
    callback show-package-detail(string);
    callback close-detail();
}


component PackageCard inherits Rectangle {
    in property <PackageItem> pkg;

    background: touch.has-hover ? Theme.card-bg-hover : Theme.card-bg;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.card-border;

    animate background { duration: 150ms; }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { AppLogic.show-package-detail(root.pkg.name); }
    }

    VerticalLayout {
        padding: 12px;
        spacing: 8px;

        // Row 1: Name, Version, Maintainer, Updated
        HorizontalBox {
            spacing: 8px;

            Text {
                text: root.pkg.name;
                font-size: 15px;
                font-weight: 700;
                color: Theme.text-accent;
            }

            Text {
                text: root.pkg.version;
                font-size: 12px;
                color: Theme.text-secondary;
                vertical-alignment: center;
            }

            Rectangle { horizontal-stretch: 1; }

            if root.pkg.maintainer != "": Text {
                text: "by " + root.pkg.maintainer;
                font-size: 11px;
                color: Theme.text-secondary;
                vertical-alignment: center;
            }

            Text {
                text: root.pkg.updated;
                font-size: 11px;
                font-weight: 600;
                color: Theme.text-date;
                vertical-alignment: center;
            }
        }

        // Row 2: Description
        Text {
            text: root.pkg.description != "" ? root.pkg.description : "(no description provided)";
            font-size: 12px;
            color: Theme.text-secondary;
            wrap: word-wrap;
            max-height: 36px;
        }

        // Row 3: Stats (Votes, Popularity)
        HorizontalBox {
            spacing: 12px;

            if root.pkg.votes > 0: Text {
                text: "▲ " + root.pkg.votes + " votes";
                font-size: 11px;
                color: Theme.vote-color;
            }

            if root.pkg.popularity != "": Text {
                text: "★ pop " + root.pkg.popularity;
                font-size: 11px;
                color: Theme.pop-color;
            }
        }
    }
}
// Search bar component for the Search tab
component SearchBar inherits Rectangle {
    in-out property <string> query: "";
    in-out property <int> by: 1;
    in-out property <bool> loading: false;
    in-out property <int> page: 1;
    in-out property <int> total-pages: 1;
    in-out property <int> result-count: 0;
    in-out property <[string]> suggestions: [];

    callback search-requested(string, int, int);
    callback page-changed(int);
    callback by-changed(int);
    callback get-suggestions(string);

    height: 80px;
    // padding moved to VerticalLayout
    background: Theme.card-bg;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.card-border;

    VerticalLayout {
        spacing: 8px;
        padding: 12px;

        // Row 1: Query input with autocomplete
        HorizontalBox {
            spacing: 8px;

            LineEdit {
                text <=> root.query;
                placeholder-text: "Search packages (name, description, maintainer, depends…)";
                horizontal-stretch: 1;
                edited => {
                    // Trigger suggestions on text change (Rust side handles min length)
                    root.get-suggestions(root.query);
                }
            }

            // Search by dropdown - simple click-to-cycle approach
            Rectangle {
                width: 140px;
                height: 32px;
                background: Theme.card-bg-hover;
                border-radius: 4px;
                border-width: 1px;
                border-color: Theme.card-border;
                Text {
                    text: root.by == 0 ? "Name" :
                          root.by == 1 ? "Name (desc)" :
                          root.by == 2 ? "Depends" :
                          root.by == 3 ? "Check Depends" :
                          root.by == 4 ? "Opt Depends" :
                          root.by == 5 ? "Make Depends" :
                          root.by == 6 ? "Maintainer" : "Submitter";
                    font-size: 12px;
                    color: Theme.text-primary;
                    vertical-alignment: center;
                    horizontal-alignment: left;
                    x: 8px;
                }
                TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => {
                        root.by = Math.mod(root.by + 1, 8);
                    }
                }
            }

            // Search button
            Button {
                text: root.loading ? "Searching…" : "Search";
                enabled: !root.loading && root.query != "";
                primary: true;
                clicked => { root.search-requested(root.query, root.by, 1); }
            }
        }

        // Row 2: Pagination & Result count
        HorizontalBox {
            spacing: 12px;
            alignment: space-between;

            Text {
                text: root.result-count > 0 ? "{root.result-count} results" : "";
                font-size: 11px;
                color: Theme.text-secondary;
                vertical-alignment: center;
            }

            HorizontalBox {
                spacing: 4px;

                Button {
                    text: "← Prev";
                    enabled: root.page > 1 && !root.loading;
                    clicked => { root.page-changed(root.page - 1); }
                }

                Text {
                    text: "Page {root.page} / {root.total-pages}";
                    font-size: 11px;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                    preferred-width: 100px;
                    horizontal-alignment: center;
                }

                Button {
                    text: "Next →";
                    enabled: root.page < root.total-pages && !root.loading;
                    clicked => { root.page-changed(root.page + 1); }
                }
            }
        }

        // Autocomplete dropdown (simple version)
        if root.suggestions.length > 0 && root.query != "": Rectangle {
            background: Theme.card-bg-hover;
            border-radius: 4px;
            border-width: 1px;
            border-color: Theme.card-border;
            max-height: 200px;
            clip: true;

            ScrollView {
                VerticalLayout {
                    for suggestion in root.suggestions: TouchArea {
                        width: 100%;
                        height: 32px;
                        clicked => {
                            root.query = suggestion;
                            root.search-requested(suggestion, root.by, 1);
                        }
                        Rectangle {
                            width: 100%;
                            height: 100%;
                            background: Theme.card-bg-hover;
                            Text {
                                text: suggestion;
                                font-size: 12px;
                                color: Theme.text-primary;
                                vertical-alignment: center;
                                horizontal-alignment: left;
                                x: 12px;
                            }
                        }
                    }
                }
            }
        }
    }
}
// Package Detail Pane (right side)
component PackageDetail inherits Rectangle {
    in property <bool> show: false;
    in property <string> name: "";
    in property <string> version: "";
    in property <string> description: "";
    in property <string> maintainer: "";
    in property <int> votes: 0;
    in property <float> popularity: 0.0;
    in property <string> url: "";
    in property <string> license: "";
    in property <[string]> depends: [];
    in property <[string]> make-depends: [];
    in property <[string]> opt-depends: [];
    in property <[string]> check-depends: [];
    in property <[string]> provides: [];
    in property <[string]> conflicts: [];
    in property <[string]> replaces: [];
    in property <[string]> groups: [];
    in property <[string]> keywords: [];
    in property <[string]> co-maintainers: [];
    in property <string> first-submitted: "";
    in property <string> last-modified: "";
    in property <string> out-of-date: "";
    in property <string> submitter: "";

    // Collapsible section states
    in-out property <bool> show-license: true;
    in-out property <bool> show-depends: true;
    in-out property <bool> show-make-depends: true;
    in-out property <bool> show-opt-depends: true;
    in-out property <bool> show-check-depends: true;
    in-out property <bool> show-provides: true;
    in-out property <bool> show-conflicts: true;
    in-out property <bool> show-replaces: true;
    in-out property <bool> show-groups: true;
    in-out property <bool> show-keywords: true;
    in-out property <bool> show-co-maintainers: true;

    width: root.show ? 400px : 0px;
    background: Theme.card-bg;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.card-border;
    animate width { duration: 200ms; }
    clip: true;

    // Header with close button
    HorizontalBox {
        height: 48px;
        padding: 12px;
        alignment: space-between;

        VerticalLayout {
            spacing: 2px;
            Text {
                text: root.name;
                font-size: 16px;
                font-weight: 700;
                color: Theme.text-accent;
            }
            Text {
                text: "v" + root.version;
                font-size: 12px;
                color: Theme.text-secondary;
            }
        }

        TouchArea {
            width: 32px;
            height: 32px;
            clicked => { AppLogic.close-detail(); }
            Rectangle {
                width: 100%;
                height: 100%;
                background: Theme.card-bg-hover;
                border-radius: 4px;
                Text {
                    text: "✕";
                    font-size: 16px;
                    color: Theme.text-secondary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }

    // Divider
    Rectangle {
        height: 1px;
        background: Theme.card-border;
    }

    ScrollView {
        VerticalLayout {
            padding: 12px;
            spacing: 16px;

            // Description
            Text {
                text: root.description != "" ? root.description : "(no description provided)";
                font-size: 13px;
                color: Theme.text-secondary;
                wrap: word-wrap;
            }

            // Maintainer & Submitter
            if root.maintainer != "" || root.submitter != "": HorizontalBox {
                spacing: 12px;
                if root.maintainer != "": Text {
                    text: "Maintainer: " + root.maintainer;
                    font-size: 12px;
                    color: Theme.text-secondary;
                }
                if root.submitter != "": Text {
                    text: "Submitter: " + root.submitter;
                    font-size: 12px;
                    color: Theme.text-secondary;
                }
            }

            // Stats
            HorizontalBox {
                spacing: 16px;
                if root.votes > 0: Text {
                    text: "▲ " + root.votes + " votes";
                    font-size: 12px;
                    color: Theme.vote-color;
                }
                if root.popularity > 0.0: Text {
                    text: "★ pop " + root.popularity;
                    font-size: 12px;
                    color: Theme.pop-color;
                }
                if root.url != "": TouchArea {
                    Text {
                        text: "Open in Browser";
                        font-size: 12px;
                        color: Theme.text-accent;
                        font-weight: 600;
                    }
                    clicked => { AppLogic.open-pkg-page(root.name); }
                }
            }

            // License
            if root.license != "": Rectangle {
                width: 100%;
                VerticalLayout {
                    spacing: 8px;

                    TouchArea {
                        height: 32px;
                        width: 100%;
                        clicked => { root.show-license = !root.show-license; }
                        Rectangle {
                            width: 100%;
                            height: 100%;
                            background: Theme.card-bg-hover;
                            border-radius: 4px;
                            HorizontalBox {
                                spacing: 8px;
                                padding: 8px;
                                Text {
                                    text: "License";
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: Theme.text-primary;
                                }
                                Text {
                                    text: root.show-license ? "▼" : "▶";
                                    font-size: 12px;
                                    color: Theme.text-secondary;
                                }
                            }
                        }
                    }

                    if root.show-license: Rectangle {
                        width: 100%;
                        VerticalLayout {
                            spacing: 4px;
                            padding-left: 16px;
                            Text {
                                text: root.license;
                                font-size: 12px;
                                color: Theme.text-secondary;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }

            // Depends
            if root.depends.length > 0: Rectangle {
                width: 100%;
                VerticalLayout {
                    spacing: 8px;

                    TouchArea {
                        height: 32px;
                        width: 100%;
                        clicked => { root.show-depends = !root.show-depends; }
                        Rectangle {
                            width: 100%;
                            height: 100%;
                            background: Theme.card-bg-hover;
                            border-radius: 4px;
                            HorizontalBox {
                                spacing: 8px;
                                padding: 8px;
                                Text {
                                    text: "Depends";
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: Theme.text-primary;
                                }
                                Text {
                                    text: root.show-depends ? "▼" : "▶";
                                    font-size: 12px;
                                    color: Theme.text-secondary;
                                }
                            }
                        }
                    }

                    if root.show-depends: Rectangle {
                        width: 100%;
                        VerticalLayout {
                            spacing: 4px;
                            padding-left: 16px;
                            for dep in root.depends: Text {
                                text: "• " + dep;
                                font-size: 12px;
                                color: Theme.text-secondary;
                            }
                        }
                    }
                }
            }
            // Make Depends
            if root.make-depends.length > 0: Rectangle {
                width: 100%;
                VerticalLayout {
                    spacing: 8px;

                    TouchArea {
                        height: 32px;
                        width: 100%;
                        clicked => { root.show-make-depends = !root.show-make-depends; }
                        Rectangle {
                            width: 100%;
                            height: 100%;
                            background: Theme.card-bg-hover;
                            border-radius: 4px;
                            HorizontalBox {
                                spacing: 8px;
                                padding: 8px;
                                Text {
                                    text: "Make Depends";
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: Theme.text-primary;
                                }
                                Text {
                                    text: root.show-make-depends ? "▼" : "▶";
                                    font-size: 12px;
                                    color: Theme.text-secondary;
                                }
                            }
                        }
                    }

                    if root.show-make-depends: Rectangle {
                        width: 100%;
                        VerticalLayout {
                            spacing: 4px;
                            padding-left: 16px;
                            for item in root.make-depends: Text {
                                text: "• " + item;
                                font-size: 12px;
                                color: Theme.text-secondary;
                            }
                        }
                    }
                }
            }

            // Opt Depends
            if root.opt-depends.length > 0: Rectangle {
                width: 100%;
                VerticalLayout {
                    spacing: 8px;

                    TouchArea {
                        height: 32px;
                        width: 100%;
                        clicked => { root.show-opt-depends = !root.show-opt-depends; }
