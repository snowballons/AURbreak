                                    color: Theme.text-secondary;
                                }
                            }
                        }
                    }

                    if root.show-groups: Rectangle {
                        width: 100%;
                        VerticalLayout {
                            spacing: 4px;
                            padding-left: 16px;
                            for item in root.groups: Text {
                                text: "• " + item;
                                font-size: 12px;
                                color: Theme.text-secondary;
                            }
                        }
                    }
                }
            }

            // Keywords
            if root.keywords.length > 0: Rectangle {
                width: 100%;
                VerticalLayout {
                    spacing: 8px;

                    TouchArea {
                        height: 32px;
                        width: 100%;
                        clicked => { root.show-keywords = !root.show-keywords; }
                        Rectangle {
                            width: 100%;
                            height: 100%;
                            background: Theme.card-bg-hover;
                            border-radius: 4px;
                            HorizontalBox {
                                spacing: 8px;
                                padding: 8px;
                                Text {
                                    text: "Keywords";
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: Theme.text-primary;
                                }
                                Text {
                                    text: root.show-keywords ? "▼" : "▶";
                                    font-size: 12px;
                                    color: Theme.text-secondary;
                                }
                            }
                        }
                    }

                    if root.show-keywords: Rectangle {
                        width: 100%;
                        VerticalLayout {
                            spacing: 4px;
                            padding-left: 16px;
                            for item in root.keywords: Text {
                                text: "• " + item;
                                font-size: 12px;
                                color: Theme.text-secondary;
                            }
                        }
                    }
                }
            }

            // Co-Maintainers
            if root.co-maintainers.length > 0: Rectangle {
                width: 100%;
                VerticalLayout {
                    spacing: 8px;

                    TouchArea {
                        height: 32px;
                        width: 100%;
                        clicked => { root.show-co-maintainers = !root.show-co-maintainers; }
                        Rectangle {
                            width: 100%;
                            height: 100%;
                            background: Theme.card-bg-hover;
                            border-radius: 4px;
                            HorizontalBox {
                                spacing: 8px;
                                padding: 8px;
                                Text {
                                    text: "Co-Maintainers";
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: Theme.text-primary;
                                }
                                Text {
                                    text: root.show-co-maintainers ? "▼" : "▶";
                                    font-size: 12px;
                                    color: Theme.text-secondary;
                                }
                            }
                        }
                    }

                    if root.show-co-maintainers: Rectangle {
                        width: 100%;
                        VerticalLayout {
                            spacing: 4px;
                            padding-left: 16px;
                            for item in root.co-maintainers: Text {
                                text: "• " + item;
                                font-size: 12px;
                                color: Theme.text-secondary;
                            }
                        }
                    }
                }
            }

            // Metadata
            HorizontalBox {
                spacing: 16px;
                if root.first-submitted != "": Text {
                    text: "First Submitted: " + root.first-submitted;
                    font-size: 11px;
                    color: Theme.text-secondary;
                }
                if root.last-modified != "": Text {
                    text: "Last Modified: " + root.last-modified;
                    font-size: 11px;
                    color: Theme.text-secondary;
                }
                if root.out-of-date != "": Text {
                    text: "Out of Date: " + root.out-of-date;
                    font-size: 11px;
                    color: Theme.warning;
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Browse Arch — Latest Modified AUR Packages";
    preferred-width: 960px;
    preferred-height: 640px;
    min-width: 700px;
    min-height: 480px;
    background: Theme.window-bg;

    VerticalLayout {
        padding: 16px;
        spacing: 16px;

        // Header bar
        HorizontalBox {
            spacing: 16px;
            alignment: space-between;

            VerticalLayout {
                spacing: 4px;
                Text {
                    text: "AUR Package Browser";
                    font-size: 20px;
                    font-weight: 700;
                    color: Theme.text-primary;
                }
                Text {
                    text: AppState.last-fetched-str != "" ? "Last updated: " + AppState.last-fetched-str : "Default view: latest modified";
                    font-size: 11px;
                    color: Theme.text-secondary;
                }
            }

            HorizontalBox {
                spacing: 8px;
                alignment: end;

                Button {
                    text: AppState.active-tab == 0 ? "● Last Updated" : "Last Updated";
                    primary: AppState.active-tab == 0;
                    clicked => { AppLogic.tab-changed(0); }
                }

                Button {
                    text: AppState.active-tab == 1 ? "● Newest (RSS)" : "Newest (RSS)";
                    primary: AppState.active-tab == 1;
                    clicked => { AppLogic.tab-changed(1); }
                }

                Button {
                    text: AppState.active-tab == 2 ? "● Search" : "Search";
                    primary: AppState.active-tab == 2;
                    clicked => { AppLogic.tab-changed(2); }
                }

                Button {
                    text: AppState.loading ? "Loading…" : "↻ Refresh";
                    enabled: !AppState.loading;
                    clicked => { AppLogic.refresh-requested(); }
                }
            }
        }
        // Search UI - different for Search tab vs other tabs
        if AppState.active-tab == 2: SearchBar {
            query <=> AppState.search-query;
            by <=> AppState.search-by;
            loading <=> AppState.search-loading;
            page <=> AppState.search-page;
            total-pages <=> AppState.search-total-pages;
            result-count <=> AppState.search-result-count;
            suggestions <=> AppState.suggestions;

            search-requested(query, by, page) => { AppLogic.search-requested(query, by, page); }
            page-changed(page) => { AppLogic.search-page-changed(page); }
            by-changed(by) => { AppLogic.search-by-changed(by); }
            get-suggestions(prefix) => { AppLogic.get-suggestions(prefix); }
        }
        if AppState.active-tab != 2: HorizontalBox {
            spacing: 8px;

            LineEdit {
                text <=> AppState.search-filter;
                placeholder-text: "Filter packages by name, description, or maintainer…";
                horizontal-stretch: 1;
            }

            Text {
                text: AppState.packages.length + " items";
                font-size: 12px;
                color: Theme.text-secondary;
                vertical-alignment: center;
            }
        }

        // Loading spinner bar
        if AppState.loading: ProgressIndicator {
            indeterminate: true;
            height: 4px;
        }

        // Main content area (list + detail pane)
        HorizontalBox {
            vertical-stretch: 1;
            spacing: 16px;

            // Package List
            ScrollView {
                horizontal-stretch: 1;
                horizontal-scrollbar-policy: always-off;

                VerticalLayout {
                    padding-right: 12px;
                    padding-bottom: 8px;
                    spacing: 8px;

                    for pkg in AppState.packages: Rectangle {
                        visible: AppState.search-filter == ""
                            || pkg.name == AppState.search-filter
                            || pkg.description == AppState.search-filter;

                        height: self.visible ? 105px : 0px;

                        PackageCard {
                            pkg: pkg;
                            width: 100%;
                            height: 100%;
                        }
                    }

                    if AppState.packages.length == 0 && !AppState.loading: Text {
                        text: AppState.active-tab == 2
                            ? "No search results. Try a different query."
                            : "No packages to show. Click Refresh to fetch latest modified packages.";
                        font-size: 14px;
                        color: Theme.text-secondary;
                        horizontal-alignment: center;
                    }
                }
            }

            // Detail Pane
            PackageDetail {
                show: AppState.show-detail;
                name: AppState.detail-name;
                version: AppState.detail-version;
                description: AppState.detail-description;
                maintainer: AppState.detail-maintainer;
                votes: AppState.detail-votes;
                popularity: AppState.detail-popularity;
                url: AppState.detail-url;
                license: AppState.detail-license;
                depends: AppState.detail-depends;
                make-depends: AppState.detail-make-depends;
                opt-depends: AppState.detail-opt-depends;
                check-depends: AppState.detail-check-depends;
                provides: AppState.detail-provides;
                conflicts: AppState.detail-conflicts;
                replaces: AppState.detail-replaces;
                groups: AppState.detail-groups;
                keywords: AppState.detail-keywords;
                co-maintainers: AppState.detail-co-maintainers;
                first-submitted: AppState.detail-first-submitted;
                last-modified: AppState.detail-last-modified;
                out-of-date: AppState.detail-out-of-date;
                submitter: AppState.detail-submitter;
            }
        }

        // Footer status bar
        HorizontalBox {
            spacing: 8px;
            Text {
                text: AppState.status-text;
                font-size: 11px;
                color: Theme.text-secondary;
                horizontal-stretch: 1;
            }
        }
    }
}