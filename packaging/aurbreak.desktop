[Desktop Entry]
Type=Application
Name=AURbreak
GenericName=Arch User Repository Browser
Comment=A very fast lightweight offline-first app for for browsing, searching, and inspecting packages from the Arch User Repository (AUR)
Exec=aurbreak %u
Icon=aurbreak
Terminal=false
Categories=System;Utility;PackageManager;
Keywords=arch;aur;package;browser;pacman;yay;paru;
StartupNotify=true
StartupWMClass=aurbreak
